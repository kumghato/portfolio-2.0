---
import Layout from '../layouts/Layout.astro';
import EditorialHero from '../components/EditorialHero.astro';
import FoundryMetrics from '../components/FoundryMetrics.astro';
import PortfolioExhibition from '../components/PortfolioExhibition.astro';
import CommissionsDialogue from '../components/CommissionsDialogue.astro';
---

<Layout title="Kumghato Khala — Web Developer & Digital Architect">
  <main class="w-full max-w-full min-h-[calc(100vh-70px)] overflow-x-clip">
    <!-- Cover Feature Hero Section -->
    <EditorialHero />

    <!-- Section 02: Foundry Metrics / Technical Atelier -->
    <FoundryMetrics />

    <!-- Section 03: Portfolio Exhibition / Selected Architectural Works -->
    <PortfolioExhibition />

    <!-- Section 04: Commissions & Dialogue / Inquiries & Editorial Desk -->
    <CommissionsDialogue />
  </main>
</Layout>
