---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Kumghato Khala',
	description = 'Portfolio of Kumghato Khala'
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-[72px] m-0 w-full max-w-[100vw] min-h-full overflow-x-clip">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="m-0 w-full max-w-[100vw] min-h-full overflow-x-clip bg-bg text-primary font-body antialiased">
		<Navbar />
		<slot />
	</body>
</html>
