    flex-direction: column;
    justify-content: space-around;
    padding: 0.75rem 1rem;
    pointer-events: none;
  }

  .metric-line {
    width: 100%;
    height: 1px;
    background-color: rgba(133, 139, 115, 0.15);
    position: relative;
  }

  .metric-line::after {
    content: attr(data-label);
    position: absolute;
    right: 0;
    top: -9px;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.45rem;
    color: rgba(133, 139, 115, 0.45);
    letter-spacing: 0.08em;
  }

  .metric-line.baseline {
    background-color: rgba(244, 241, 234, 0.3);
  }

  .typeforge-glyph-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .didone-specimen-art {
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-weight: 900;
    color: #f4f1ea;
    display: flex;
    align-items: baseline;
    line-height: 0.8;
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .monument-char {
    font-size: 7.5rem;
    letter-spacing: -0.06em;
  }

  .monument-amp {
    font-size: 4.5rem;
    font-style: italic;
    color: var(--exhibition-olive);
    margin-left: -0.75rem;
    opacity: 0.85;
  }

  .typeforge-bezier-overlay {
    position: absolute;
    width: 80%;
    height: 80%;
    pointer-events: none;
  }

  .typeforge-axes-panel {
    position: absolute;
    bottom: 0.65rem;
    left: 0.75rem;
    display: flex;
    gap: 0.65rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.5rem;
    background-color: rgba(20, 22, 18, 0.85);
    border: 1px solid rgba(133, 139, 115, 0.25);
    padding: 0.25rem 0.6rem;
  }

  .axis-token {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .axis-tag {
    color: #858b73;
    font-weight: 700;
  }

  .axis-bar {
    width: 32px;
    height: 3px;
    background-color: rgba(244, 241, 234, 0.15);
    display: inline-block;
    position: relative;
  }

  .axis-fill {
    height: 100%;
    background-color: #858b73;
    display: block;
  }

  .axis-num {
    color: #f4f1ea;
  }

  /* Stage 3: Neo Broadsheet */
  .stage-broadsheet {
    background-color: #0f110e;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .broadsheet-layout {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid rgba(133, 139, 115, 0.2);
    padding: 0.65rem;
    background-color: #121511;
  }

  .broadsheet-masthead {
    border-bottom: 1px solid rgba(133, 139, 115, 0.25);
    padding-bottom: 0.35rem;
    margin-bottom: 0.45rem;
    text-align: center;
  }

  .masthead-pre {
    display: block;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.42rem;
    letter-spacing: 0.16em;
    color: #858b73;
    text-transform: uppercase;
  }

  .masthead-name {
    margin: 0.1rem 0;
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #f4f1ea;
    text-transform: uppercase;
  }

  .masthead-sub-rule {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.42rem;
    color: rgba(244, 241, 234, 0.45);
    border-top: 1px solid rgba(133, 139, 115, 0.15);
    padding-top: 0.15rem;
    margin-top: 0.15rem;
  }

  .broadsheet-columns {
    display: grid;
    grid-template-columns: 1.25fr 1fr 0.8fr;
    gap: 0.6rem;
    height: 100%;
    overflow: hidden;
  }

  .broadsheet-col {
    border-right: 1px solid rgba(133, 139, 115, 0.18);
    padding-right: 0.5rem;
  }

  .broadsheet-col:last-child {
    border-right: none;
    padding-right: 0;
  }

  .broadsheet-subhead {
    margin: 0 0 0.25rem 0;
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-size: 0.6rem;
    font-weight: 800;
    line-height: 1.15;
    color: #f4f1ea;
    text-transform: uppercase;
  }

  .broadsheet-p {
    margin: 0 0 0.35rem 0;
    font-family: var(--font-body, 'Newsreader Variable', 'Newsreader', Georgia, serif);
    font-size: 0.55rem;
    line-height: 1.35;
    color: rgba(244, 241, 234, 0.7);
  }

  .broadsheet-pullquote {
    font-family: var(--font-body, 'Newsreader Variable', 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 0.55rem;
    line-height: 1.3;
    color: #858b73;
    border-left: 1.5px solid #858b73;
    padding-left: 0.35rem;
    margin-top: 0.2rem;
  }

  .broadsheet-plate-mini {
    border: 1px solid rgba(133, 139, 115, 0.25);
    padding: 0.2rem;
    margin-bottom: 0.3rem;
  }

  .mini-plate-img {
    height: 48px;
    background: linear-gradient(135deg, #1c2018 0%, #2a3024 100%);
    border: 1px dashed rgba(133, 139, 115, 0.3);
  }

  .mini-plate-cap {
    display: block;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.4rem;
    color: rgba(244, 241, 234, 0.5);
    margin-top: 0.2rem;
    letter-spacing: 0.06em;
  }

  .broadsheet-barcode-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: rgba(244, 241, 234, 0.6);
  }

  .barcode-svg {
    height: 20px;
    width: 100%;
  }

  .barcode-label {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.38rem;
    letter-spacing: 0.08em;
  }

  .broadsheet-badge-stamp {
    display: inline-block;
    border: 1px solid var(--exhibition-olive);
    color: var(--exhibition-olive);
    padding: 0.15rem 0.35rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.45rem;
    font-weight: 700;
    margin-top: 0.5rem;
  }

  /* Stage 4: Pulse Commerce */
  .stage-pulse {
    background-color: #111310;
    padding: 0.75rem 0.9rem;
  }

  .pulse-storefront-layout {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid rgba(133, 139, 115, 0.2);
    padding: 0.6rem;
    background-color: #141712;
  }

  .pulse-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(133, 139, 115, 0.2);
    padding-bottom: 0.35rem;
    margin-bottom: 0.6rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.48rem;
  }

  .pulse-brand {
    font-weight: 700;
    color: #f4f1ea;
    letter-spacing: 0.1em;
  }

  .pulse-nav-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(244, 241, 234, 0.6);
  }

  .pulse-cart-chip {
    background-color: #858b73;
    color: #121411;
    padding: 0.1rem 0.3rem;
    font-weight: 700;
  }

  .pulse-product-display {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 0.85rem;
    height: 100%;
    align-items: center;
  }

  .product-visual-box {
    height: 100%;
    border: 1px solid rgba(133, 139, 115, 0.25);
    background: radial-gradient(circle at 50% 40%, #1e221a 0%, #10120f 80%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .visual-pedestal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .pedestal-wireframe {
    width: 54px;
    height: 54px;
    border: 1px solid rgba(244, 241, 234, 0.35);
    transform: rotate(45deg);
    background-color: rgba(133, 139, 115, 0.12);
  }

  .pedestal-tag {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.42rem;
    color: #858b73;
    letter-spacing: 0.08em;
  }

  .product-spec-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .edition-num {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.45rem;
    color: #858b73;
    letter-spacing: 0.1em;
  }

  .edition-title {
    margin: 0;
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-size: 0.85rem;
    font-weight: 800;
    color: #f4f1ea;
    letter-spacing: -0.01em;
  }

  .edition-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0.2rem 0;
  }

  .price-val {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.65rem;
    font-weight: 700;
    color: #f4f1ea;
  }

  .currency-toggle {
    display: flex;
    gap: 0.25rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.45rem;
  }

  .currency-toggle .curr {
    color: rgba(244, 241, 234, 0.4);
    padding: 0.05rem 0.2rem;
  }

  .currency-toggle .curr.is-active {
    color: #858b73;
    font-weight: 700;
    border-bottom: 1px solid #858b73;
  }

  .edge-diagnostics-card {
    background-color: rgba(16, 18, 14, 0.9);
    border: 1px solid rgba(133, 139, 115, 0.2);
    padding: 0.35rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.45rem;
  }

  .diag-line {
    display: flex;
    justify-content: space-between;
  }

  .diag-k {
    color: rgba(244, 241, 234, 0.5);
  }

  .diag-v {
    color: #f4f1ea;
    font-weight: 700;
  }

  .diag-v.text-highlight {
    color: #858b73;
  }

  /* ==========================================================================
     CARD BODY: BADGE, TITLE, DESCRIPTION, METRIC FOOTER
     ========================================================================== */
  .card-body {
    padding: 1.5rem 1.75rem 1.65rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 1.15rem;
  }

  /* Top Badge Row */
  .card-badge-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .project-badge-pill {
    background-color: var(--exhibition-charcoal);
    color: #ffffff;
    padding: 0.25rem 0.65rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tech-tags-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tech-stack-tag {
    background-color: var(--exhibition-olive-tint);
    border: 1px solid rgba(133, 139, 115, 0.35);
    color: var(--exhibition-olive-dark);
    padding: 0.2rem 0.5rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Card Project Title */
  .card-title-group {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .card-project-title {
    margin: 0;
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-size: clamp(1.45rem, 2.1vw, 1.95rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--exhibition-charcoal);
  }

  .project-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .project-title-link:hover {
    color: var(--exhibition-olive-dark);
  }

  .project-chronology {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--exhibition-charcoal-muted);
  }

  /* Descriptive Paragraph */
  .card-project-description {
    margin: 0;
    font-family: var(--font-body, 'Newsreader Variable', 'Newsreader', Georgia, serif);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--exhibition-charcoal);
    opacity: 0.9;
    white-space: pre-line;
  }

  /* Bottom Technical Metadata Bar */
  .card-technical-footer {
    margin-top: auto;
    padding-top: 1.15rem;
    border-top: 1px solid var(--exhibition-hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .metric-highlights-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--exhibition-charcoal);
    font-weight: 600;
  }

  .metric-bullet {
    color: var(--exhibition-olive);
    font-size: 0.5rem;
  }

  .metric-highlight-text {
    color: var(--exhibition-charcoal);
  }

  /* Action Buttons: LIVE & GIT SPEC */
  .card-action-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .action-case-study,
  .action-live {
    background-color: var(--exhibition-charcoal);
    border: 1px solid var(--exhibition-charcoal);
    color: #ffffff;
  }

  .action-case-study:hover,
  .action-live:hover {
    background-color: var(--exhibition-olive-dark);
    border-color: var(--exhibition-olive-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(26, 26, 26, 0.12);
  }

  .action-case-study .action-arrow,
  .action-live .action-arrow {
    transition: transform 0.2s ease;
  }

  .action-case-study:hover .action-arrow,
  .action-live:hover .action-arrow {
    transform: translate(2px, -2px);
  }

  .action-git-spec {
    background-color: transparent;
    border: 1px solid var(--exhibition-hairline-bold);
    color: var(--exhibition-charcoal);
  }

  .action-git-spec:hover {
    border-color: var(--exhibition-charcoal);
    background-color: rgba(26, 26, 26, 0.04);
    transform: translateY(-1px);
  }

  /* ==========================================================================
     EXHIBITION SUMMARY COLOPHON STRIP
     ========================================================================== */
  .exhibition-colophon-strip {
    margin-top: 3.5rem;
    background-color: rgba(251, 249, 245, 0.85);
    border: 1px solid var(--exhibition-hairline);
    padding: 1.65rem 1rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    text-align: center;
  }

  .colophon-col {
    padding: 0 1rem;
    border-right: 1px solid var(--exhibition-hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .colophon-col:last-child {
    border-right: none;
  }

  .colophon-strong {
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-size: clamp(1.85rem, 2.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--exhibition-charcoal);
  }

  .colophon-unit {
    font-size: 1rem;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-weight: 400;
    color: var(--exhibition-olive-dark);
    margin-left: 2px;
  }

  .colophon-caption {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--exhibition-charcoal);
    margin-top: 0.5rem;
  }

  .colophon-sub {
    font-family: var(--font-body, 'Newsreader Variable', 'Newsreader', Georgia, serif);
    font-size: 0.75rem;
    font-style: italic;
    color: var(--exhibition-charcoal-muted);
    margin-top: 0.15rem;
  }

  /* ==========================================================================
     ACCESSIBLE CASE STUDY MODAL DIALOG
     ========================================================================== */
  .case-study-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 820px;
    width: 92%;
    margin: auto;
    overflow: visible;
  }

  .case-study-dialog::backdrop {
    background-color: rgba(26, 26, 26, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .dialog-content-wrapper {
    background-color: #fcfbf9;
    border: 1px solid var(--exhibition-hairline-bold);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }

  .dialog-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.5rem;
    background-color: rgba(235, 230, 218, 0.6);
    border-bottom: 1px solid var(--exhibition-hairline);
    font-family: var(--font-label, 'Space Mono', monospace);
  }

  .dialog-meta-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .dialog-badge {
    background-color: var(--exhibition-charcoal);
    color: #ffffff;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    letter-spacing: 0.1em;
  }

  .dialog-chronology {
    font-size: 0.6875rem;
    color: var(--exhibition-charcoal-muted);
    letter-spacing: 0.08em;
  }

  .dialog-close-btn {
    background: transparent;
    border: none;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.6875rem;
    color: var(--exhibition-charcoal);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    transition: color 0.2s ease;
  }

  .dialog-close-btn:hover {
    color: var(--exhibition-olive-dark);
  }

  .dialog-body {
    padding: 2.25rem 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .dialog-header-area {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-bottom: 1px solid var(--exhibition-hairline);
    padding-bottom: 1.5rem;
  }

  .dialog-category {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--exhibition-olive-dark);
    font-weight: 700;
    text-transform: uppercase;
  }

  .dialog-title {
    margin: 0;
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-size: clamp(2rem, 3.5vw, 2.85rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--exhibition-charcoal);
  }

  .dialog-thesis {
    margin: 0;
    font-family: var(--font-body, 'Newsreader Variable', 'Newsreader', Georgia, serif);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--exhibition-charcoal);
  }

  .dialog-grid-details {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
  }

  .dialog-subheading {
    margin: 0 0 1rem 0;
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--exhibition-olive-dark);
    font-weight: 700;
    border-bottom: 1px solid var(--exhibition-hairline);
    padding-bottom: 0.4rem;
  }

  .dialog-highlights-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.highlight-list-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-body, 'Newsreader Variable', 'Newsreader', Georgia, serif);
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--exhibition-charcoal);
  }

  :global(.highlight-list-item .bullet) {
    color: var(--exhibition-olive);
    font-size: 0.6rem;
    margin-top: 0.25rem;
  }

  .dialog-benchmarks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  :global(.benchmark-cell) {
    background-color: rgba(235, 230, 218, 0.4);
    border: 1px solid var(--exhibition-hairline);
    padding: 0.65rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  :global(.bench-label) {
