---
interface Project {
  id: string;
  badge: string;
  title: string;
  chronology: string;
  category: string;
  filterCategory: string;
  techStack: string[];
  description: string;
  metricHighlight1: string;
  metricHighlight2: string;
  urlSlug: string;
  windowStatus: string;
  plateId: string;
  folioRef: string;
  displayResolution: string;
  previewType: 'browser' | 'monitor' | 'broadsheet' | 'storefront';
  previewImage?: string;
  liveUrl: string;
  caseStudyUrl?: string;
  gitSpecUrl: string;
  deepDive: {
    thesis: string;
    architecturalHighlights: string[];
    benchmarkMetrics: { label: string; value: string }[];
  };
}

const projects: Project[] = [
  {
    id: "livemaster",
    badge: "PROJECT 01",
    title: "Livemaster Audio & Visuals",
    chronology: "2024",
    category: "Production Stage Systems • Interactive Web",
    filterCategory: "systems",
    techStack: ["NEXT JS", "FRAMER MOTION", "TAILWIND CSS"],
    description: "Engineered a modern, performance-optimized promotional website for a premier audio-visual provider specializing in professional sound reinforcement, intelligent lighting rigs, and high-resolution LED video walls. Designed with smooth, scroll-driven parallax transitions to deliver an engaging, high-end digital experience for both event rentals and permanent commercial installations.",
    metricHighlight1: "Audio, Lights & LED Panels",
    metricHighlight2: "Rental & Permanent Installs",
    urlSlug: "livemaster.audio-visuals.production",
    windowStatus: "NEXT.JS // FRAMER MOTION",
    plateId: "SPECIMEN LMV-01",
    folioRef: "STAGE: SOUND & LIGHT",
    displayResolution: "2540×1293 • RESPONSIVE",
    previewType: "browser",
    previewImage: "/Assets/projects/Livemaster.png",
    liveUrl: "https://livemaster2-0.vercel.app/",
    caseStudyUrl: "#case-study-livemaster",
    gitSpecUrl: "https://github.com/kumghato/livemaster2.0",
    deepDive: {
      thesis: "Architecting a high-performance digital presence for professional audio-visual production, stage rental inventory, and venue installation engineering with fluid Framer Motion choreography.",
      architecturalHighlights: [
        "Component-driven stage inventory architecture built with Next.js",
        "Fluid cinematic layout choreography and spring physics using Framer Motion",
        "High-density responsive media showcase optimized for stage equipment, rigs, and LED walls",
        "Streamlined client inquiry pipelines for rental logistics and permanent architectural installations"
      ],
      benchmarkMetrics: [
        { label: "Architecture", value: "Next.js App Router" },
        { label: "Motion Engine", value: "Framer Motion" },
        { label: "A/V Inventory", value: "Sound, Lights & LED" },
        { label: "Repository", value: "livemaster2.0" }
      ]
    }
  },
  {
    id: "reverse-luts",
    badge: "PROJECT 02",
    title: "Reverse LUTS",
    chronology: "2024",
    category: "GPU Color Science • Client-Side Log Conversion",
    filterCategory: "systems",
    techStack: ["ASTRO JS", "TAILWIND CSS"],
    description: "Remove LUTs and undo color grading from standard JPEG, PNG, or WebP photos using GPU-accelerator client side log conversion tool mathematically decompresses Rec709 to Log signals, restores flat color profiles, and lifts shadows--creating a flat image generator curve equivalent to ARRI LogC, Sony S-Log3, or Cineon flat profiles.\n\nThis app is designed for beginners who wants to learn color grading without expensive cinema gear.",
    metricHighlight1: "Rec.709 to Log Decompression",
    metricHighlight2: "ARRI LogC & S-Log3 Profiles",
    urlSlug: "reverseluts.pages.dev",
    windowStatus: "ASTRO JS // GPU ACCELERATED",
    plateId: "SPECIMEN RLT-02",
    folioRef: "COLOR SCIENCE: LOG RESTORATION",
    displayResolution: "CLIENT LOGC • REAL-TIME GPU",
    previewType: "browser",
    previewImage: "/Assets/project/reverseLUTS.png",
    liveUrl: "https://reverseluts.pages.dev/",
    caseStudyUrl: "https://reverseluts.pages.dev/",
    gitSpecUrl: "https://github.com/kumghato/ReverseLUTs",
    deepDive: {
      thesis: "Mathematical Rec.709-to-Log decompression engine engineered in Astro JS that restores flat dynamic range and lifts clipped shadows directly on the client GPU.",
      architecturalHighlights: [
        "GPU-accelerated client-side log conversion pipeline built with Astro JS",
        "Mathematical decompression from standard Rec.709 color space to flat Log signals",
        "Profile emulation equivalent to ARRI LogC, Sony S-Log3, and Cineon flat curves",
        "Local client-side execution designed for aspiring colorists without expensive cinema gear"
      ],
      benchmarkMetrics: [
        { label: "Architecture", value: "Astro JS" },
        { label: "Target Profiles", value: "ARRI LogC / S-Log3 / Cineon" },
        { label: "Processing", value: "Client-Side GPU Pipeline" },
        { label: "Platform", value: "Cloudflare Pages" }
      ]
    }
  },
  {
    id: "multi-trading-view",
    badge: "PROJECT 03",
    title: "Multi Trading View",
    chronology: "2024",
    category: "Financial Systems • Real-Time WebSockets",
    filterCategory: "systems",
    techStack: ["NEXT JS", "TAILWIND CSS"],
    description: "Engineered a high-performance multi-view financial dashboard that aggregates real-time market data across stocks, cryptocurrencies, and precious metals. Integrated Yahoo Finance for broader market data alongside Hyperliquid WebSockets for sub-second crypto feed streaming, paired with the TradingView API for advanced technical analysis and interactive live charting.",
    metricHighlight1: "Yahoo Finance & Hyper Liquid WS",
    metricHighlight2: "TradingView Live Chart API",
    urlSlug: "multi-trading-view.vercel.app",
    windowStatus: "NEXT.JS // TRADINGVIEW API",
    plateId: "SPECIMEN MTV-03",
    folioRef: "FINANCIAL TELEMETRY: REAL-TIME CHARTS",
    displayResolution: "LIVE WEBSOCKET • MULTI-VIEW",
    previewType: "browser",
    previewImage: "/Assets/projects/multitradingview.png",
    liveUrl: "https://multi-trading-view.vercel.app/",
    caseStudyUrl: "https://multi-trading-view.vercel.app/",
    gitSpecUrl: "https://github.com/kumghato/MultiTradingView",
    deepDive: {
      thesis: "Engineering a multi-view financial telemetry workstation integrating Yahoo Finance, Hyper Liquid WebSockets, and TradingView charting engines for unified real-time market surveillance.",
      architecturalHighlights: [
        "Concurrent real-time WebSocket feeds connecting Hyper Liquid and Yahoo Finance market streams",
        "TradingView API integration for interactive technical chart analysis",
        "Multi-view dashboard tracking live market prices of Stocks, Crypto, Metals, and more",
        "Component architecture engineered with Next.js and styled with Tailwind CSS"
      ],
      benchmarkMetrics: [
        { label: "Architecture", value: "Next.js App Router" },
        { label: "Styling Engine", value: "Tailwind CSS" },
        { label: "Realtime Feeds", value: "Hyper Liquid & Yahoo Finance" },
        { label: "Charting Engine", value: "TradingView API" }
      ]
    }
  },
  {
    id: "mcq-mocktest",
    badge: "PROJECT 04",
    title: "MCQ Mock test Generator",
    chronology: "2024",
    category: "AI Systems • Gemini Powered Assessment",
    filterCategory: "systems",
    techStack: ["NEXT JS", "TAILWIND CSS", "GEMINI API"],
    description: "Developed an intelligent, dynamic MCQ generation platform tailored for competitive examinations. Powered by the Gemini API, the system enables candidates to curate customized practice tests by selecting specific subjects or generating comprehensive, full-syllabus mock exams with automated question variation and detailed explanation",
    metricHighlight1: "Gemini AI Quiz Generation",
    metricHighlight2: "Subject & Syllabus Filtering",
    urlSlug: "freemocktest.vercel.app",
    windowStatus: "NEXT.JS // GEMINI API",
    plateId: "SPECIMEN MCQ-04",
    folioRef: "AI ASSESSMENT: MOCK TEST ENGINE",
    displayResolution: "1738×987 • RESPONSIVE",
    previewType: "browser",
    previewImage: "/Assets/projects/freemocktest.png",
    liveUrl: "https://freemocktest.vercel.app/",
    caseStudyUrl: "https://freemocktest.vercel.app/",
    gitSpecUrl: "https://github.com/kumghato/mocktest",
    deepDive: {
      thesis: "Engineering an AI-powered examination engine with Next.js and Google Gemini API that generates syllabus-specific and subject-focused mock tests for competitive exam aspirants.",
      architecturalHighlights: [
        "Automated MCQ generation pipeline powered by Google Gemini API",
        "Dynamic syllabus and subject filtering architecture for targeted competitive exam preparation",
        "Responsive examination interface built with Next.js and styled with Tailwind CSS",
        "Instant evaluation and scoring system for competitive exam preparation"
      ],
      benchmarkMetrics: [
        { label: "Architecture", value: "Next.js App Router" },
        { label: "AI Engine", value: "Google Gemini API" },
        { label: "Styling Engine", value: "Tailwind CSS" },
        { label: "Repository", value: "mocktest" }
      ]
    }
  }
];
---

<section 
  class="portfolio-exhibition-wrapper" 
  id="selected-works" 
  aria-labelledby="exhibition-heading"
>
  <!-- Architectural Top Framing Hairline Strip -->
  <div class="exhibition-sub-bar" aria-label="Portfolio Exhibition Archival Registry">
    <div class="exhibition-container">
      <div class="meta-grid">
        <div class="meta-item meta-title">
          <span class="meta-strong">SECTION 03</span>
          <span class="meta-divider">—</span>
          <span>PORTFOLIO EXHIBITION</span>
        </div>

        <div class="meta-item meta-disciplines">
          <span class="meta-label">CURATION:</span>
          <span class="meta-strong">04 ARCHITECTURAL WORKS</span>
        </div>

        <div class="meta-item meta-standards">
          <span class="meta-label">CHRONOLOGY:</span>
          <span class="meta-strong">2024</span>
        </div>

        <div class="meta-item meta-status">
          <span class="meta-label">AUDIT:</span>
          <span class="meta-badge-pulse">PRODUCTION GRADE</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Exhibition Content Container -->
  <div class="exhibition-main-body">
    <div class="exhibition-container">

      <!-- ========================================== -->
      <!-- SECTION HEADER: HIGH-CONTRAST DIDONE SERIF -->
      <!-- ========================================== -->
      <div class="exhibition-header-block">
        <div class="header-left">
          <!-- Subhead Tag -->
          <div class="tag-row">
            <span class="olive-tag">
              <span class="tag-dot" aria-hidden="true"></span>
              SECTION 03 // PORTFOLIO EXHIBITION
            </span>
          </div>

          <!-- Main Headline -->
          <h2 id="exhibition-heading" class="exhibition-headline">
            SELECTED ARCHITECTURAL WORKS
          </h2>

          <div class="header-sub-tagline">
            <span>ENGINEERED PRODUCTION CASE STUDIES &amp; OPEN REPOSITORIES</span>
          </div>
        </div>

        <!-- Accompanying Italicized Editorial Aside (Right Aligned) -->
        <div class="header-right">
          <blockquote class="editorial-aside">
            <p>
              “FOUR PRODUCTION CASE STUDIES (2024)”
            </p>
          </blockquote>
          <div class="editorial-citation">
            <span class="citation-folio">VOL. XIV • WORKS CATALOGUE</span>
            <span class="citation-dot">•</span>
            <span>INDEX: PRODUCTION GRADE</span>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- EXHIBITION TOOLBAR / CURATION STRIP        -->
      <!-- ========================================== -->
      <div class="exhibition-toolbar-bar">
        <div class="toolbar-left">
          <span class="toolbar-label">ARCHIVE INDEX:</span>
          <div class="filter-pills-list" role="tablist" aria-label="Filter case studies by category">
            <button type="button" class="filter-pill is-active" data-filter="all" role="tab" aria-selected="true">
              <span class="filter-dot" aria-hidden="true"></span>
              <span>ALL WORKS (04)</span>
            </button>
            <button type="button" class="filter-pill" data-filter="systems" role="tab" aria-selected="false">
              <span>SYSTEMS &amp; REALTIME</span>
            </button>
            <button type="button" class="filter-pill" data-filter="typography" role="tab" aria-selected="false">
              <span>TYPOGRAPHY &amp; SHADERS</span>
            </button>
            <button type="button" class="filter-pill" data-filter="editorial" role="tab" aria-selected="false">
              <span>EDITORIAL &amp; COMMERCE</span>
            </button>
          </div>
        </div>

        <div class="toolbar-right">
          <div class="curation-badge-chip">
            <span class="pulse-indicator" aria-hidden="true"></span>
            <span>PRODUCTION DEPLOYMENTS // LIVE CODEBASES</span>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- 2X2 PROJECT SHOWCASE GRID                  -->
      <!-- ========================================== -->
      <div class="showcase-grid" id="showcase-grid" role="region" aria-label="Case Studies 2x2 Grid">
        {projects.map((project, idx) => (
          <article 
            class="project-card" 
            data-project-id={project.id}
            data-category={project.filterCategory}
          >
            <!-- Architectural Registration Corner Marks -->
            <span class="card-corner top-left" aria-hidden="true">⌜</span>
            <span class="card-corner top-right" aria-hidden="true">⌝</span>
            <span class="card-corner bottom-left" aria-hidden="true">⌞</span>
            <span class="card-corner bottom-right" aria-hidden="true">⌟</span>

            <!-- Top Visual Preview Container: Mock Browser / Monitor / Print Spread -->
            <div class="preview-container">
              <div class="mock-window">
                <!-- Mock Browser Chrome Header Bar -->
                <div class="mock-chrome">
                  <div class="chrome-traffic-lights" aria-hidden="true">
                    <span class="traffic-dot dot-close"></span>
                    <span class="traffic-dot dot-minimize"></span>
                    <span class="traffic-dot dot-expand"></span>
                  </div>

                  <div class="chrome-address-bar">
                    <span class="address-lock" aria-hidden="true">🔒</span>
                    <span class="address-url">{project.urlSlug}</span>
                  </div>

                  <div class="chrome-status-tag">
                    <span class="chrome-status-pulse" aria-hidden="true"></span>
                    <span class="chrome-status-text">{project.windowStatus}</span>
                  </div>
                </div>

                <!-- Visual Preview Screen Stage (Dark Editorial Duotone Screen) -->
                <div class={`mock-viewport theme-${project.id}`}>
                  {project.previewImage && (
                    <div class="preview-stage stage-image">
                      <a 
                        href={project.liveUrl}
                        target={project.liveUrl.startsWith('http') ? "_blank" : undefined}
                        rel={project.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                        class="stage-image-link"
                        aria-label={`Open live site for ${project.title}`}
                      >
                        <img 
                          src={project.previewImage} 
                          alt={project.title} 
                          class="preview-stage-img" 
                          loading="lazy" 
                        />
                        <div class="stage-image-overlay" aria-hidden="true"></div>
                      </a>
                    </div>
                  )}

                  {project.id === 'chronos-telemetry' && (
                    <div class="preview-stage stage-chronos">
                      <!-- Telemetry Grid Background -->
                      <div class="chronos-grid-lines" aria-hidden="true">
                        <div class="grid-line horizontal" style="top: 25%;"></div>
                        <div class="grid-line horizontal" style="top: 50%;"></div>
                        <div class="grid-line horizontal" style="top: 75%;"></div>
                        <div class="grid-line vertical" style="left: 20%;"></div>
                        <div class="grid-line vertical" style="left: 45%;"></div>
                        <div class="grid-line vertical" style="left: 70%;"></div>
                      </div>

                      <!-- Oscilloscope & Waveform Graphic -->
                      <svg class="chronos-svg-graph" viewBox="0 0 640 240" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <defs>
                          <linearGradient id="chronosGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#858b73" stop-opacity="0.4" />
                            <stop offset="100%" stop-color="#858b73" stop-opacity="0.0" />
                          </linearGradient>
                        </defs>
                        <!-- Area Fill -->
                        <path d="M0 160 Q 60 80, 120 140 T 240 110 T 360 170 T 480 60 T 600 130 L 640 140 L 640 240 L 0 240 Z" fill="url(#chronosGradient)" />
                        <!-- Primary Telemetry Trace -->
                        <path d="M0 160 Q 60 80, 120 140 T 240 110 T 360 170 T 480 60 T 600 130 L 640 140" stroke="#f4f1ea" stroke-width="2.5" stroke-linecap="round" />
                        <!-- High Frequency Spike Curve -->
                        <path d="M0 175 L 80 175 L 90 60 L 105 210 L 120 150 L 140 175 L 280 175 L 300 45 L 320 220 L 340 175 L 640 175" stroke="#858b73" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.85" />
                        <!-- Coordinate Intersect Markers -->
                        <circle cx="480" cy="60" r="4.5" fill="#f4f1ea" stroke="#121411" stroke-width="2" />
                        <line x1="480" y1="0" x2="480" y2="240" stroke="#858b73" stroke-width="1" stroke-dasharray="2 4" opacity="0.6" />
                        <line x1="0" y1="60" x2="640" y2="60" stroke="#858b73" stroke-width="1" stroke-dasharray="2 4" opacity="0.6" />
                      </svg>

                      <!-- HUD Micro-Diagnostics Overlay -->
                      <div class="chronos-hud">
                        <div class="hud-pill">
                          <span class="hud-label">SAB RING:</span>
                          <span class="hud-val">65,536 SLOTS</span>
                        </div>
                        <div class="hud-pill">
                          <span class="hud-label">TICKS:</span>
                          <span class="hud-val">250,000/S</span>
                        </div>
                        <div class="hud-pill highlight">
                          <span class="hud-label">LATENCY:</span>
                          <span class="hud-val">0.38MS</span>
                        </div>
                      </div>

                      <div class="chronos-crosshairs" aria-hidden="true">
                        <span class="crosshair-coord top-right">LOC: [X: 480.00, Y: 060.00]</span>
                        <span class="crosshair-coord bottom-left">FPS_STABLE: 60.0 // ZERO_JANK</span>
                      </div>
                    </div>
                  )}

                  {project.id === 'typeforge-foundry' && (
                    <div class="preview-stage stage-typeforge">
                      <!-- Typographic Drafting Grid -->
                      <div class="typeforge-grid" aria-hidden="true">
                        <div class="metric-line ascender" data-label="ASCENDER (800)"></div>
                        <div class="metric-line cap-height" data-label="CAP HEIGHT (720)"></div>
                        <div class="metric-line x-height" data-label="X-HEIGHT (510)"></div>
                        <div class="metric-line baseline" data-label="BASELINE (000)"></div>
                        <div class="metric-line descender" data-label="DESCENDER (-210)"></div>
                      </div>

                      <!-- Monumental Bodoni Serif Glyph Specimen -->
                      <div class="typeforge-glyph-container">
                        <div class="didone-specimen-art" aria-hidden="true">
                          <span class="monument-char">B</span>
                          <span class="monument-amp">&amp;</span>
                        </div>

                        <!-- Bézier Vector Coordinate Handles -->
                        <svg class="typeforge-bezier-overlay" viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <!-- Bézier Tangent Lines -->
                          <line x1="80" y1="140" x2="140" y2="40" stroke="#858b73" stroke-width="1" stroke-dasharray="2 2" />
                          <line x1="220" y1="40" x2="280" y2="140" stroke="#858b73" stroke-width="1" stroke-dasharray="2 2" />
                          <circle cx="140" cy="40" r="3.5" fill="#f4f1ea" stroke="#858b73" stroke-width="1.5" />
                          <circle cx="220" cy="40" r="3.5" fill="#f4f1ea" stroke="#858b73" stroke-width="1.5" />
                          <rect x="76" y="136" width="8" height="8" fill="#858b73" />
                          <rect x="276" y="136" width="8" height="8" fill="#858b73" />
                        </svg>
                      </div>

                      <!-- Variable Font Axes Inspector Bar -->
                      <div class="typeforge-axes-panel">
                        <div class="axis-token">
                          <span class="axis-tag">WGHT</span>
                          <span class="axis-bar"><span class="axis-fill" style="width: 85%;"></span></span>
                          <span class="axis-num">850</span>
                        </div>
                        <div class="axis-token">
                          <span class="axis-tag">OPSZ</span>
                          <span class="axis-bar"><span class="axis-fill" style="width: 72%;"></span></span>
                          <span class="axis-num">72PT</span>
                        </div>
                        <div class="axis-token">
                          <span class="axis-tag">KERN</span>
                          <span class="axis-bar"><span class="axis-fill" style="width: 95%;"></span></span>
                          <span class="axis-num">-12</span>
                        </div>
                      </div>
                    </div>
                  )}




                  <!-- In-Plate Archival Watermark Bottom Bar -->
                  <div class="mock-plate-caption">
                    <div class="caption-left">
                      <span class="plate-code">{project.plateId}</span>
                      <span class="plate-divider">•</span>
                      <span class="plate-ref">{project.folioRef}</span>
                    </div>
                    <div class="caption-right">
                      <span class="plate-resolution">{project.displayResolution}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Body: Badge, Tags, Title, Paragraph, Metadata -->
            <div class="card-body">
              <!-- Top Badge & Tech Stack Row -->
              <div class="card-badge-row">
                <div class="project-badge-pill">
                  <span class="badge-num">{project.badge}</span>
                </div>
                <div class="tech-tags-list" aria-label={`Tech stack for ${project.title}`}>
                  {project.techStack.map(tag => (
                    <span class="tech-stack-tag">{tag}</span>
                  ))}
                </div>
              </div>

              <!-- Bold Serif Project Title & Chronology -->
              <div class="card-title-group">
                <h3 class="card-project-title">
                  <a 
                    href={project.liveUrl} 
                    class="project-title-link"
                    target={project.liveUrl.startsWith('http') ? "_blank" : undefined}
                    rel={project.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                  >
                    {project.title}
                  </a>
                </h3>
                <span class="project-chronology">{project.chronology}</span>
              </div>

              <!-- Descriptive Paragraph Explaining Technical Objective -->
              <p class="card-project-description">
                {project.description}
              </p>

              <!-- Bottom Technical Metadata Bar -->
              <div class="card-technical-footer">
                <div class="metric-highlights-group" aria-label="Technical Highlights">
                  <div class="metric-item">
                    <span class="metric-bullet" aria-hidden="true">■</span>
                    <span class="metric-highlight-text">{project.metricHighlight1}</span>
                  </div>
                  <div class="metric-item">
                    <span class="metric-bullet" aria-hidden="true">■</span>
                    <span class="metric-highlight-text">{project.metricHighlight2}</span>
                  </div>
                </div>

                <div class="card-action-links">
                  <a 
                    href={project.liveUrl} 
                    class="action-btn action-live"
                    target={project.liveUrl.startsWith('http') ? "_blank" : undefined}
                    rel={project.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                    aria-label={`View live site for ${project.title}`}
                  >
                    <span class="btn-label">LIVE</span>
                    <span class="action-arrow" aria-hidden="true">↗</span>
                  </a>

                  <a 
                    href={project.gitSpecUrl} 
                    class="action-btn action-git-spec"
                    target="_blank" 
                    rel="noopener noreferrer"
                    aria-label={`View Git repository specification for ${project.title}`}
                  >
                    <span class="btn-label">GIT SPEC</span>
                    <span class="action-icon" aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- ACCESSIBLE CASE STUDY MODAL DIALOG         -->
  <!-- ========================================== -->
  <dialog class="case-study-dialog" id="case-study-modal" aria-labelledby="dialog-title">
    <div class="dialog-backdrop" id="dialog-backdrop-area"></div>
    <div class="dialog-content-wrapper" role="document">
      <div class="dialog-top-bar">
        <div class="dialog-meta-header">
          <span class="dialog-badge" id="modal-project-badge">PROJECT 01</span>
          <span class="dialog-chronology" id="modal-project-chronology">2024</span>
        </div>
        <button type="button" class="dialog-close-btn" id="modal-close-btn" aria-label="Close Case Study Dialog">
          <span class="close-text">CLOSE [ESC]</span>
          <span class="close-icon" aria-hidden="true">✕</span>
        </button>
      </div>

      <div class="dialog-body">
        <div class="dialog-header-area">
          <span class="dialog-category" id="modal-project-category">PRODUCTION STAGE SYSTEMS</span>
          <h3 class="dialog-title" id="dialog-title">Livemaster Audio & Visuals</h3>
          <p class="dialog-thesis" id="modal-project-thesis">
            Architecting a high-performance digital presence for professional audio-visual production, stage rental inventory, and venue installation engineering with fluid Framer Motion choreography.
          </p>
        </div>

        <div class="dialog-grid-details">
