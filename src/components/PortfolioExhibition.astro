---
interface Project {
  id: string;
  badge: string;
  title: string;
  chronology: string;
  techStack: string[];
  description: string;
  metricHighlight1: string;
  metricHighlight2: string;
  urlSlug: string;
  windowStatus: string;
  plateId: string;
  folioRef: string;
  displayResolution: string;
  previewImage: string;
  liveUrl: string;
  gitSpecUrl: string;
