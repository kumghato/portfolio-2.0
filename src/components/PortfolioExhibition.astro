---

<script is:inline>
  if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('exhibition-motion-ready');
  }
</script>

<section 
  class="portfolio-exhibition-wrapper relative z-20 w-full bg-editorial-bg border-b border-hairline scroll-mt-[72px]" 
  id="selected-works" 
  aria-labelledby="exhibition-heading"
>
  <!-- Architectural Top Framing Hairline Strip -->
  <div class="exhibition-sub-bar" aria-label="Portfolio Exhibition Archival Registry">
    <div class="exhibition-container">
      <div class="meta-grid">
        <div class="meta-item meta-title">
          <span class="meta-strong">SECTION 03</span>
          <span class="meta-divider">—</span>
          <span>PORTFOLIO EXHIBITION</span>
        </div>

        <div class="meta-item meta-disciplines">
          <span class="meta-label">CURATION:</span>
          <span class="meta-strong">04 ARCHITECTURAL WORKS</span>
        </div>

        <div class="meta-item meta-standards">
          <span class="meta-label">CHRONOLOGY:</span>
          <span class="meta-strong">{presentYear}</span>
        </div>

        <div class="meta-item meta-status">
          <span class="meta-label">AUDIT:</span>
          <span class="meta-badge-pulse">PRODUCTION GRADE</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Exhibition Content Container -->
  <div class="exhibition-main-body">
    <div class="exhibition-container">

      <!-- ========================================== -->
      <!-- SECTION HEADER: HIGH-CONTRAST DIDONE SERIF -->
      <!-- ========================================== -->
      <div class="exhibition-header-block">
        <div class="header-left">
          <!-- Subhead Tag -->
          <div class="tag-row">
            <span class="olive-tag">
              <span class="tag-dot" aria-hidden="true"></span>
              SECTION 03 // PORTFOLIO EXHIBITION
            </span>
          </div>

          <!-- Main Headline -->
          <h2 id="exhibition-heading" class="exhibition-headline">
            SELECTED ARCHITECTURAL WORKS
          </h2>

          <div class="header-sub-tagline">
            <span>ENGINEERED PRODUCTION &amp; OPEN REPOSITORIES</span>
          </div>
        </div>

        <!-- Accompanying Italicized Editorial Aside (Right Aligned) -->
        <div class="header-right">
          <blockquote class="editorial-aside">
            <p>
              “True art is creation, and creation is beyond all theories”
              <br>
              <pre style="display:flex; justify-content:flex-end;">-Carl Gustav Jung </pre>
            </p>
          </blockquote>
        </div>
      </div>


      <!-- ========================================== -->
      <!-- 2X2 PROJECT SHOWCASE GRID                  -->
      <!-- ========================================== -->
      <div class="showcase-grid" id="showcase-grid" role="region" aria-label="Case Studies 2x2 Grid">
        {projects.map((project, idx) => (
          <article 
            class="project-card" 
            data-project-id={project.id}
          >
            <!-- Architectural Registration Corner Marks -->
            <span class="card-corner top-left" aria-hidden="true">⌜</span>
            <span class="card-corner top-right" aria-hidden="true">⌝</span>
            <span class="card-corner bottom-left" aria-hidden="true">⌞</span>
            <span class="card-corner bottom-right" aria-hidden="true">⌟</span>

            <!-- Top Visual Preview Container: Mock Browser / Monitor / Print Spread -->
            <div class="preview-container">
              <div class="mock-window">
                <!-- Mock Browser Chrome Header Bar -->
                <div class="mock-chrome">
                  <div class="chrome-traffic-lights" aria-hidden="true">
                    <span class="traffic-dot dot-close"></span>
                    <span class="traffic-dot dot-minimize"></span>
                    <span class="traffic-dot dot-expand"></span>
                  </div>

                  <div class="chrome-address-bar">
                    <span class="address-lock" aria-hidden="true">🔒</span>
                    <span class="address-url">{project.urlSlug}</span>
                  </div>

                  <div class="chrome-status-tag">
                    <span class="chrome-status-pulse" aria-hidden="true"></span>
                    <span class="chrome-status-text">{project.windowStatus}</span>
                  </div>
                </div>

                <!-- Visual Preview Screen Stage (Dark Editorial Duotone Screen) -->
                <div class={`mock-viewport theme-${project.id}`}>
                  <div class="preview-stage stage-image">
                    <a 
                      href={project.liveUrl}
                      target={project.liveUrl.startsWith('http') ? "_blank" : undefined}
                      rel={project.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                      class="stage-image-link"
                      aria-label={`Open live site for ${project.title}`}
                    >
                      <img 
                        src={project.previewImage} 
                        alt={project.title} 
                        class="preview-stage-img" 
                        loading="lazy" 
                      />
                      <div class="stage-image-overlay" aria-hidden="true"></div>
                    </a>
                  </div>

                  <!-- In-Plate Archival Watermark Bottom Bar -->
                  <div class="mock-plate-caption">
                    <div class="caption-left">
                      <span class="plate-code">{project.plateId}</span>
                      <span class="plate-divider">•</span>
                      <span class="plate-ref">{project.folioRef}</span>
                    </div>
                    <div class="caption-right">
                      <span class="plate-resolution">{project.displayResolution}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Body: Badge, Tags, Title, Paragraph, Metadata -->
            <div class="card-body">
              <!-- Top Badge & Tech Stack Row -->
              <div class="card-badge-row">
                <div class="project-badge-pill">
                  <span class="badge-num">{project.badge}</span>
                </div>
                <div class="tech-tags-list" aria-label={`Tech stack for ${project.title}`}>
                  {project.techStack.map(tag => (
                    <span class="tech-stack-tag">{tag}</span>
                  ))}
                </div>
              </div>

              <!-- Bold Serif Project Title & Chronology -->
              <div class="card-title-group">
                <h3 class="card-project-title">
                  <a 
                    href={project.liveUrl} 
                    class="project-title-link"
                    target={project.liveUrl.startsWith('http') ? "_blank" : undefined}
                    rel={project.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                  >
                    {project.title}
                  </a>
                </h3>
              
              </div>

              <!-- Descriptive Paragraph Explaining Technical Objective -->
              <p class="card-project-description">
                {project.description}
              </p>

              <!-- Bottom Technical Metadata Bar -->
              <div class="card-technical-footer">
                <div class="metric-highlights-group" aria-label="Technical Highlights">
                  <div class="metric-item">
                    <span class="metric-bullet" aria-hidden="true">■</span>
                    <span class="metric-highlight-text">{project.metricHighlight1}</span>
                  </div>
                  <div class="metric-item">
                    <span class="metric-bullet" aria-hidden="true">■</span>
                    <span class="metric-highlight-text">{project.metricHighlight2}</span>
                  </div>
                </div>

                <div class="card-action-links">
                  <a 
                    href={project.liveUrl} 
                    class="action-btn action-live"
                    target={project.liveUrl.startsWith('http') ? "_blank" : undefined}
                    rel={project.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                    aria-label={`View live site for ${project.title}`}
                  >
                    <span class="btn-label">LIVE</span>
                    <span class="action-arrow" aria-hidden="true">↗</span>
                  </a>

                  <a 
                    href={project.gitSpecUrl} 
                    class="action-btn action-git-spec"
                    target="_blank" 
                    rel="noopener noreferrer"
                    aria-label={`View Git repository specification for ${project.title}`}
                  >
                    <span class="btn-label">GIT SPEC</span>
                    <span class="action-icon" aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>




<script>
  import { animate, stagger, inView } from 'motion';

  function initExhibitionAnimations() {
    const exhibitionWrapper = document.getElementById('selected-works');
    if (!exhibitionWrapper) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      document.documentElement.classList.remove('exhibition-motion-ready');
      return;
    }

    // Target elements
    const headerBlock = exhibitionWrapper.querySelector('.exhibition-header-block') as HTMLElement | null;
    const headline = exhibitionWrapper.querySelector('.exhibition-headline') as HTMLElement | null;
    const subTagline = exhibitionWrapper.querySelector('.header-sub-tagline') as HTMLElement | null;
    const asideP = exhibitionWrapper.querySelector('.editorial-aside p') as HTMLElement | null;
    const tag = exhibitionWrapper.querySelector('.olive-tag') as HTMLElement | null;
    const showcaseGrid = exhibitionWrapper.querySelector('#showcase-grid') as HTMLElement | null;
    const cards = Array.from(exhibitionWrapper.querySelectorAll('.project-card')) as HTMLElement[];

    // Split text into words and individual character spans for a typing effect without a cursor
    function prepareTyping(container: HTMLElement): HTMLElement[] {
      const existing = container.querySelectorAll('.exhibition-type-char');
      if (existing.length > 0) {
        return Array.from(existing) as HTMLElement[];
      }

      const chars: HTMLElement[] = [];

      // Preserve accessibility: store full text in aria-label for screen readers
      if (!container.getAttribute('aria-label')) {
        const fullText = container.textContent?.replace(/\s+/g, ' ').trim() || '';
        if (fullText) {
          container.setAttribute('aria-label', fullText);
        }
      }

      function walk(node: Node) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent || '';
          if (!text) return;

          // Ignore pure whitespace text nodes formatting between elements
          if (/^\s+$/.test(text)) {
            return;
          }

          const tokens = text.split(/(\s+)/);
          const frag = document.createDocumentFragment();

          for (const token of tokens) {
            if (!token) continue;
            if (/^\s+$/.test(token)) {
              frag.appendChild(document.createTextNode(token));
            } else {
              const wordSpan = document.createElement('span');
              wordSpan.className = 'exhibition-type-word';
              wordSpan.setAttribute('aria-hidden', 'true');

              for (const c of Array.from(token)) {
                const charSpan = document.createElement('span');
                charSpan.className = 'exhibition-type-char';
                charSpan.style.opacity = '0';
                charSpan.textContent = c;
                charSpan.setAttribute('aria-hidden', 'true');
                wordSpan.appendChild(charSpan);
                chars.push(charSpan);
              }
              frag.appendChild(wordSpan);
            }
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const el = node as HTMLElement;
          if (el.classList.contains('exhibition-type-word') || el.classList.contains('exhibition-type-char')) {
            return;
          }
          Array.from(node.childNodes).forEach(walk);
        }
      }

      walk(container);
      return chars;
    }

    // Prepare typing structures
    const headlineChars = headline ? prepareTyping(headline) : [];
    const subTaglineChars = subTagline ? prepareTyping(subTagline) : [];
    const asideChars = asideP ? prepareTyping(asideP) : [];

    // Make containers visible now that inner character spans are at opacity: 0
    if (headline) headline.style.visibility = 'visible';
    if (subTagline) subTagline.style.visibility = 'visible';
    if (asideP) asideP.style.visibility = 'visible';

    let hasRun = false;
    let currentRunId = 0;
    let activeAnimations: any[] = [];

    function resetAnimations() {
      currentRunId++;
      activeAnimations.forEach((a) => {
        try {
          if (typeof a.cancel === 'function') a.cancel();
          else if (typeof a.stop === 'function') a.stop();
        } catch (_) {}
      });
      activeAnimations = [];

      function clearElementAnim(el: HTMLElement | null) {
        if (el && typeof el.getAnimations === 'function') {
          el.getAnimations().forEach((a) => { try { a.cancel(); } catch (_) {} });
        }
      }

      if (tag) {
        clearElementAnim(tag);
        tag.style.opacity = '0';
      }
      cards.forEach((card) => {
        clearElementAnim(card);
        card.style.opacity = '0';
      });
      headlineChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });
      subTaglineChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });
      asideChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });

      hasRun = false;
    }

    function playAnimations() {
      if (hasRun) return;
      hasRun = true;
      const runId = ++currentRunId;

      const animations: any[] = [];

      // 1. Tag (SECTION 03 // PORTFOLIO EXHIBITION)
      if (tag) {
        animations.push(
          animate(tag, { opacity: [0, 1] }, { duration: 0.35, delay: 0.05, ease: 'easeOut' })
        );
      }

      // 2. Heading: SELECTED ARCHITECTURAL WORKS (Typing effect without typing cursor)
      if (headlineChars.length > 0) {
        animations.push(
          animate(
            headlineChars,
            { opacity: [0, 1] },
            {
              duration: 0.1,
              delay: stagger(0.038, { startDelay: 0.15 }),
              ease: 'linear'
            }
          )
        );
      }

      // 3. Section that displays the card (0 opacity to 100 opacity, smooth transition)
      // Exactly matches Right Column: Monograph Plate from hero section, appearing one by one (one after the other)
      if (cards.length > 0) {
        animations.push(
          animate(
            cards,
            { opacity: [0, 1] },
            {
              duration: 4,
              delay: stagger(1, { startDelay: 0.3 }),
              ease: [0.16, 1, 0.3, 1]
            }
          )
        );
      }

      // 4. Sub-tagline: ENGINEERED PRODUCTION & OPEN REPOSITORIES (Typing effect)
      if (subTaglineChars.length > 0) {
        animations.push(
          animate(
            subTaglineChars,
            { opacity: [0, 1] },
            {
              duration: 0.01,
              delay: stagger(0.012, { startDelay: 0.75 }),
              ease: 'linear'
            }
          )
        );
      }

      // 5. Aside description quote (Typing effect without typing cursor)
      if (asideChars.length > 0) {
        animations.push(
          animate(
            asideChars,
            { opacity: [0, 1] },
            {
              duration: 0.01,
              delay: stagger(0.009, { startDelay: 1 }),
              ease: 'linear'
            }
          )
        );
      }

      activeAnimations = animations;

      // Cleanup upon animation completion
      Promise.allSettled(animations).then(() => {
        if (runId !== currentRunId) return;
        cards.forEach((card) => {
          card.style.opacity = '1';
        });
        if (tag) {
          tag.style.opacity = '1';
        }
        headlineChars.forEach((c) => { c.style.opacity = '1'; });
        subTaglineChars.forEach((c) => { c.style.opacity = '1'; });
        asideChars.forEach((c) => { c.style.opacity = '1'; });
      });

      // Safety fallback: guarantee full visibility
      setTimeout(() => {
        cards.forEach((card) => { card.style.opacity = '1'; });
        if (tag) tag.style.opacity = '1';
        headlineChars.forEach((c) => { c.style.opacity = '1'; });
        subTaglineChars.forEach((c) => { c.style.opacity = '1'; });
        asideChars.forEach((c) => { c.style.opacity = '1'; });
      }, 600);
    }

    // Set initial hidden state
    resetAnimations();

    function checkExhibitionViewport() {
      if (!exhibitionWrapper) return;
      const rect = exhibitionWrapper.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const scrollY = window.scrollY || window.pageYOffset;

      // In viewport check: when section top enters bottom 85% of viewport and bottom hasn't scrolled completely away
      const isInView = rect.top < windowHeight * 0.85 && rect.bottom > 80;
      // Section is completely below viewport (user scrolled up above it, e.g. at Hero or scrolling up to top)
      const isBelowViewport = (rect.top >= windowHeight + 40) || (scrollY <= 80);

      if (isInView && !hasRun) {
        playAnimations();
      } else if (isBelowViewport && hasRun) {
        resetAnimations();
      }
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          checkExhibitionViewport();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    window.addEventListener('app:reset-scroll-animations', () => {
      resetAnimations();
    });

    if (typeof IntersectionObserver !== 'undefined') {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasRun) {
            checkExhibitionViewport();
          }
        });
      }, { threshold: 0.1 });
      observer.observe(exhibitionWrapper);
    }

    checkExhibitionViewport();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExhibitionAnimations);
  } else {
    initExhibitionAnimations();
  }
  document.addEventListener('astro:page-load', initExhibitionAnimations);
</script>
