---
import SealLogo from './SealLogo.astro';

interface Props {
  name?: string;
  role?: string;
  headlineTop?: string;
  headlineBottom?: string;
  bioHook?: string;
}
const presentYear = new Date().getFullYear();

const {
  name = "Kumghato K Khala",
  role = "Web Developer",
  headlineTop = "THE ART OF",
  headlineBottom = "Creation.",
  bioHook = `“A Web developer with a foundational background in Civil engineering and professional Audio production. I bring a rigorous, system-level mindset to the web, building scalable, high-efficiency digital products rooted in structural integrity and clean, zero-dependency code.”`
} = Astro.props;
---

<script is:inline>
  if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('hero-motion-ready');
  }
</script>

<div class="editorial-hero-wrapper sticky top-0 z-10 w-full min-h-screen min-h-[100dvh] overflow-hidden scroll-mt-[72px] border-b border-hairline bg-editorial-bg text-charcoal bg-[radial-gradient(rgba(26,26,26,0.04)_1px,transparent_1px)] bg-[size:24px_24px]" id="cover-feature">
  <!-- Archival Watermark Seal Design in Hero Background -->
  <div class="hero-watermark-wrapper absolute top-[53%] left-[45%] -translate-x-1/2 -translate-y-1/2 -rotate-8 w-[clamp(520px,52vw,840px)] h-[clamp(520px,52vw,840px)] pointer-events-none select-none z-0 flex items-center justify-center opacity-[0.075] transition-opacity duration-300 max-[1024px]:top-[32%] max-[1024px]:left-1/2 max-[1024px]:w-[clamp(340px,80vw,560px)] max-[1024px]:h-[clamp(340px,80vw,560px)] max-[1024px]:opacity-[0.07] max-[640px]:top-[25%] max-[640px]:w-[clamp(280px,88vw,420px)] max-[640px]:h-[clamp(280px,88vw,420px)] max-[640px]:opacity-[0.065]" aria-hidden="true">
    <div class="hero-watermark-aura absolute -inset-[14%] rounded-full bg-[radial-gradient(circle,rgba(133,139,115,0.15)_0%,rgba(244,241,234,0)_70%)] pointer-events-none"></div>
    <div class="hero-watermark-outer-ring absolute -inset-[4%] rounded-full border-[1.5px] border-dashed border-[rgba(26,26,26,0.35)] pointer-events-none"></div>
    <SealLogo size="100%" class="hero-watermark-svg w-full h-full block drop-shadow-[0_0_1px_rgba(26,26,26,0.15)]" />
  </div>

  <!-- ========================================== -->
  <!-- SUB-HEADER BAR: METADATA, ISSUE & PRICING -->
  <!-- ========================================== -->
  <aside class="sub-header-bar max-[768px]:hidden w-full relative z-[1] border-b border-hairline bg-[rgba(235,230,218,0.4)] font-label text-[0.6875rem] tracking-[0.14em] uppercase text-charcoal" aria-label="Editorial Monograph Metadata">
    <div class="hero-container max-w-[var(--container-max-width,1540px)] mx-auto px-[var(--container-padding,clamp(1.25rem,3.2vw,2.5rem))] relative z-[1] max-[768px]:px-[var(--container-padding,1.25rem)]">
      <div class="meta-grid grid grid-cols-4 max-[1024px]:grid-cols-2 max-[768px]:grid-cols-1">
        <div class="meta-item meta-issue py-3 px-4 flex items-center gap-2 border-r border-hairline max-[1024px]:border-r max-[768px]:border-r-0 max-[768px]:border-t max-[768px]:border-hairline max-[768px]:py-2 max-[768px]:px-0 max-[768px]:first:border-t-0">
          <span class="meta-strong font-bold text-charcoal">VOL. XIV</span>
          <span class="meta-divider text-hairline">—</span>
          <span>ISSUE 08 / {presentYear}</span>
        </div>

        <div class="meta-item meta-cities py-3 px-4 flex items-center justify-center gap-2 border-r border-hairline max-[1024px]:border-r-0 max-[768px]:justify-start max-[768px]:border-t max-[768px]:border-hairline max-[768px]:py-2 max-[768px]:px-0">
          <span>NAGALAND • KOHIMA </span>
        </div>

        <div class="meta-item meta-circulation py-3 px-4 flex items-center justify-center gap-2 border-r border-hairline max-[1024px]:border-t max-[1024px]:border-r max-[1024px]:border-hairline max-[768px]:border-r-0 max-[768px]:justify-start max-[768px]:border-t max-[768px]:py-2 max-[768px]:px-0">
          <span class="meta-label text-charcoal-muted">STACK:</span>
          <span class="meta-strong font-bold text-charcoal">MERN · NEXT</span>
        </div>

        <div class="meta-item meta-pricing py-3 px-4 flex items-center justify-end gap-2 border-r-0 max-[1024px]:border-t max-[1024px]:border-hairline max-[768px]:justify-start max-[768px]:border-t max-[768px]:py-2 max-[768px]:px-0">
          <span class="meta-label text-charcoal-muted">STATUS:</span>
          <span class="meta-strong font-bold text-charcoal">AVAILABLE</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- ========================================== -->
  <!-- MAIN HERO SECTION: ASYMMETRIC GRID        -->
  <!-- ========================================== -->
  <section class="editorial-hero-section py-[4.5rem] pb-[5.5rem] max-[640px]:py-12 max-[640px]:pb-16">
    <div class="hero-container max-w-[var(--container-max-width,1540px)] mx-auto px-[var(--container-padding,clamp(1.25rem,3.2vw,2.5rem))] relative z-[1] max-[768px]:px-[var(--container-padding,1.25rem)]">
      <div id="hero-inner-frame" class="w-full will-change-transform origin-top max-[1024px]:origin-bottom">
        <div class="asymmetric-layout grid grid-cols-[minmax(0,1.35fr)_minmax(380px,460px)] gap-[clamp(2.5rem,3.5vw,4rem)] items-start 2xl:grid-cols-[minmax(0,1.45fr)_minmax(460px,560px)] 2xl:gap-20 max-[1024px]:grid-cols-1 max-[1024px]:gap-14">

          <!-- ======================================== -->
          <!-- LEFT COLUMN: EDITORIAL CORE              -->
          <!-- ======================================== -->
          <div class="editorial-core flex flex-col gap-8">
            
            <!-- Category Accent Tag -->
            <div class="tag-row flex items-center">
              <span class="olive-tag inline-flex items-center gap-2 py-[0.3rem] px-[0.65rem] bg-olive-tint border border-[rgba(133,139,115,0.35)] text-olive-dark font-label text-[0.6875rem] font-semibold tracking-[0.12em] uppercase">
                <span class="tag-dot w-1.5 h-1.5 rounded-full bg-olive-dark" aria-hidden="true"></span>
                DEVELOPER PROFILE &amp; RETROSPECTIVE
              </span>
            </div>

            <!-- Massive High-Contrast Serif Headline -->
            <h1 class="editorial-headline m-0 leading-[0.92] flex flex-col select-none">
              <span class="headline-bold font-headline text-[clamp(3.5rem,7.5vw,6.75rem)] 2xl:text-[clamp(5rem,5.5vw,8rem)] max-[640px]:text-[clamp(2.3rem,9.5vw,4.2rem)] max-[380px]:text-[clamp(1.95rem,8.5vw,2.3rem)] font-black tracking-[-0.05em] uppercase text-charcoal">{headlineTop}</span>
              <span class="headline-italic font-headline text-[clamp(3rem,6.5vw,5.85rem)] 2xl:text-[clamp(4.2rem,4.8vw,7rem)] max-[640px]:text-[clamp(2rem,8.5vw,3.8rem)] max-[380px]:text-[clamp(1.75rem,7.5vw,2.1rem)] font-normal italic tracking-[-0.02em] !text-secondary mt-1">
                {headlineBottom.replace('.', '')}<span class="headline-dot font-normal text-secondary not-italic font-light">.</span>
              </span>
            </h1>

            <!-- Monograph Lead Hook / Bio -->
            <blockquote class="bio-hook m-0 py-1 pl-5 border-l-2 border-olive">
              <p class="font-body text-[clamp(1.2rem,1.8vw,1.45rem)] 2xl:text-[1.6rem] 2xl:max-w-[800px] max-[640px]:text-[1.15rem] italic leading-[1.45] text-charcoal m-0 max-w-[650px]">{bioHook}</p>
            </blockquote>

            <!-- Section Index / Salient Theses List -->
            <div class="theses-block flex flex-col gap-3 mt-2 2xl:gap-4">
              <div class="theses-header flex justify-between items-center pb-2 border-b border-hairline font-label text-[0.625rem] max-[380px]:text-[0.5625rem] tracking-[0.16em] uppercase text-charcoal-muted">
                <span class="theses-caption font-bold">SALIENT THESES &amp; MONOGRAPH OUTLINE</span>
                <span class="theses-vol max-[380px]:hidden">CHAPTER COMPILATION</span>
              </div>

              <ol class="theses-list list-none m-0 p-0 flex flex-col">
                <!-- Item 01 -->
                <li class="thesis-item border-b border-hairline">
                  <div  class="thesis-link group flex justify-between items-baseline gap-5 py-[0.85rem] px-2 -mx-2 no-underline text-charcoal transition-colors duration-200">
                    <div class="thesis-title-group flex items-baseline gap-3 min-w-0">
                      <span class="thesis-number font-label text-xs font-bold text-olive-dark shrink-0">01.</span>
                      <span class="thesis-name font-body text-[1.0625rem] 2xl:text-[1.25rem] max-[380px]:text-[0.95rem] font-semibold text-charcoal transition-colors duration-200">Architectonics of the Modern Viewport</span>
                    </div>
                    <div class="thesis-meta-group flex items-baseline gap-5 shrink-0 whitespace-nowrap">
                      <span class="thesis-page font-label text-xs font-bold text-charcoal whitespace-nowrap shrink-0">P. 016</span>
                    </div>
                  </div>
                </li>

                <!-- Item 02 -->
                <li class="thesis-item border-b border-hairline">
                   <div  class="thesis-link group flex justify-between items-baseline gap-5 py-[0.85rem] px-2 -mx-2 no-underline text-charcoal transition-colors duration-200">
                    <div class="thesis-title-group flex items-baseline gap-3 min-w-0">
                      <span class="thesis-number font-label text-xs font-bold text-olive-dark shrink-0">02.</span>
                      <span class="thesis-name font-body text-[1.0625rem] 2xl:text-[1.25rem] max-[380px]:text-[0.95rem] font-semibold text-charcoal transition-colors duration-200 ">Architectural Parallax: Kinetic Micro-Interactions</span>
                    </div>
                    <div class="thesis-meta-group flex items-baseline gap-5 shrink-0 whitespace-nowrap">
                      <span class="thesis-page font-label text-xs font-bold text-charcoal whitespace-nowrap shrink-0">P. 028</span>
                    </div>
                   </div>
                </li>

                <!-- Item 03 -->
                <li class="thesis-item border-b border-hairline">
                    <div  class="thesis-link group flex justify-between items-baseline gap-5 py-[0.85rem] px-2 -mx-2 no-underline text-charcoal transition-colors duration-200">
                    <div class="thesis-title-group flex items-baseline gap-3 min-w-0">
                      <span class="thesis-number font-label text-xs font-bold text-olive-dark shrink-0">03.</span>
                      <span class="thesis-name font-body text-[1.0625rem] 2xl:text-[1.25rem] max-[380px]:text-[0.95rem] font-semibold text-charcoal transition-colors duration-200 ">Heuristics of Minimalist Systems</span>
                    </div>
                    <div class="thesis-meta-group flex items-baseline gap-5 shrink-0 whitespace-nowrap">
                      <span class="thesis-page font-label text-xs font-bold text-charcoal whitespace-nowrap shrink-0">P. 042</span>
                    </div>
                  </div>
                </li>
              </ol>
            </div>

            <!-- Action Buttons Array -->
            <div class="actions-strip flex flex-row flex-wrap items-center gap-[0.85rem] pt-2 w-full max-[768px]:flex-col max-[768px]:items-stretch max-[768px]:gap-3">
              <!-- Secondary Outline Action -->
              <a href="#technical-atelier" class="btn btn-outline inline-flex items-center justify-center no-underline font-label text-[0.7rem] 2xl:text-[0.8rem] 2xl:py-[1.05rem] 2xl:px-[1.6rem] tracking-[0.08em] font-semibold py-[0.85rem] px-5 whitespace-nowrap transition-all duration-200 cursor-pointer leading-none max-[768px]:w-full max-[768px]:min-h-[44px] bg-[rgba(251,249,245,0.45)] text-charcoal border border-charcoal hover:bg-charcoal hover:text-editorial-bg gap-2">
                <span class="btn-text">INSPECT TECHNICAL ATELIER</span>
              </a>

              <!-- Olive Accent Action -->
              <a href="#colophon-inquiries" class="btn btn-olive inline-flex items-center justify-center no-underline font-label text-[0.7rem] 2xl:text-[0.8rem] 2xl:py-[1.05rem] 2xl:px-[1.6rem] tracking-[0.08em] font-semibold py-[0.85rem] px-5 whitespace-nowrap transition-all duration-200 cursor-pointer leading-none max-[768px]:w-full max-[768px]:min-h-[44px] bg-olive text-white border border-olive hover:bg-olive-dark hover:border-olive-dark gap-2">
                <span class="btn-text">CONTACT</span>
              </a>
            </div>

            <!-- Editorial Colophon Micro-Stamps -->
            <div class="editorial-footnote font-label text-[0.625rem] tracking-[0.08em] text-charcoal-muted flex flex-wrap items-center gap-[0.65rem] pt-2">
              <span>ORIGINAL CURATION: {name.toUpperCase()} ARCHIVES</span>
              <span class="dot-separator text-hairline">•</span>
              <span>TYPESET IN BODONI &amp; NEWSREADER</span>
              <span class="dot-separator text-hairline">•</span>
              <span>FOLIO NO. 14-88A</span>
            </div>

          </div>

          <!-- ======================================== -->
          <!-- RIGHT COLUMN: MONOGRAPH PLATE            -->
          <!-- ======================================== -->
          <div class="monograph-plate-col flex flex-col gap-6 max-[1024px]:max-w-[580px] max-[1024px]:w-full max-[1024px]:mx-auto">
            
            <!-- Polaroid / Archival Plate Card Frame -->
            <div class="plate-card bg-white p-6 2xl:p-9 max-[640px]:p-[1.15rem] max-[380px]:p-[0.85rem] border border-hairline shadow-[0_14px_40px_-10px_rgba(26,26,26,0.12)] relative">
              <!-- Registration Corner Marks -->
              <span class="corner-mark top-left font-label text-[0.625rem] text-[rgba(26,26,26,0.3)] select-none leading-none absolute top-2 left-2" aria-hidden="true">⌜</span>
              <span class="corner-mark top-right font-label text-[0.625rem] text-[rgba(26,26,26,0.3)] select-none leading-none absolute top-2 right-2" aria-hidden="true">⌝</span>
              <span class="corner-mark bottom-left font-label text-[0.625rem] text-[rgba(26,26,26,0.3)] select-none leading-none absolute bottom-2 left-2" aria-hidden="true">⌞</span>
              <span class="corner-mark bottom-right font-label text-[0.625rem] text-[rgba(26,26,26,0.3)] select-none leading-none absolute bottom-2 right-2" aria-hidden="true">⌟</span>

              <!-- Top Plate Header -->
              <div class="plate-meta-top flex justify-between items-center pb-3 mb-3 border-b border-[rgba(26,26,26,0.08)] font-label text-[0.5625rem] tracking-[0.14em] uppercase text-charcoal-muted">
                <span>ARCHIVE RECORD • PLATE 01</span>
                <span>FIG. 4.2 / STUDIO WORKSTATION</span>
              </div>

              <!-- Framed Photograph -->
              <div class="plate-image-frame group relative aspect-[4/4.8] overflow-hidden bg-black border border-[rgba(26,26,26,0.12)]">
                <img 
                  src="/assets/photo.jpg" 
                  alt={`${name} portrait photograph`}
                  class="plate-image w-full h-full object-cover object-[center_20%] grayscale contrast-[110%] transition-[transform,filter] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03] group-hover:grayscale group-hover:contrast-[115%]"
                  loading="eager"
                  width="1499"
                  height="2123"
                />
                <div class="plate-image-gradient absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

                <!-- Overlaid Physical Archive Stamp -->
                <div class="plate-badge-bottom-left absolute bottom-3 left-3 bg-black/75 text-white font-label text-[0.5rem] tracking-[0.15em] uppercase py-1 px-2 border border-white/20 backdrop-blur-[4px]">
                  {name.split(' ').map(n => n[0]).join('')} // ARCHIVES
                </div>
                <div class="plate-badge-bottom-right absolute bottom-3 right-3 bg-black/60 text-white/90 font-label text-[0.5625rem] py-[0.15rem] px-[0.4rem]">
                  35MM DUPONT NEGATIVE
                </div>
              </div>

              <!-- Plate Caption Block Underneath -->
              <div class="plate-caption-block mt-4 pt-3 border-t border-[rgba(26,26,26,0.12)] flex flex-col gap-2.5">
                <div class="plate-caption-header flex justify-between items-baseline">
                  <span class="plate-caption-tag font-label text-[0.625rem] font-bold tracking-[0.14em] uppercase text-olive-dark">PLATE I — COVER FEATURE</span>
                  <span class="plate-caption-date font-label text-[0.5625rem] text-charcoal-muted">{presentYear}</span>
                </div>
                <p class="plate-caption-text font-body text-[0.9375rem] leading-[1.45] text-charcoal m-0">
                 {role} {name} on craft, zero-dependency purity, and radical web performance.”
                </p>

                <!-- Barcode Graphic & ISBN Tracking Number -->
                <div class="plate-barcode-footer pt-3 border-t border-[rgba(26,26,26,0.08)] flex items-end justify-between gap-4 max-[380px]:flex-col max-[380px]:items-start max-[380px]:gap-2.5">
                  <div class="barcode-container flex flex-col gap-1">
                    <svg class="barcode-svg h-7 w-[10.5rem] text-charcoal max-[380px]:max-w-[140px]" viewBox="0 0 176 30" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-label="Monograph tracking barcode">
                      <rect x="0" y="0" width="2" height="30" />
                      <rect x="4" y="0" width="1" height="30" />
                      <rect x="7" y="0" width="3" height="30" />
                      <rect x="12" y="0" width="1" height="30" />
                      <rect x="15" y="0" width="4" height="30" />
                      <rect x="21" y="0" width="2" height="30" />
                      <rect x="25" y="0" width="1" height="30" />
                      <rect x="28" y="0" width="3" height="30" />
                      <rect x="33" y="0" width="2" height="30" />
                      <rect x="37" y="0" width="4" height="30" />
                      <rect x="43" y="0" width="1" height="30" />
                      <rect x="46" y="0" width="3" height="30" />
                      <rect x="51" y="0" width="2" height="30" />
                      <rect x="55" y="0" width="2" height="30" />
                      <rect x="59" y="0" width="1" height="30" />
                      <rect x="62" y="0" width="4" height="30" />
                      <rect x="68" y="0" width="2" height="30" />
                      <rect x="72" y="0" width="1" height="30" />
                      <rect x="75" y="0" width="3" height="30" />
                      <rect x="80" y="0" width="2" height="30" />
                      <rect x="84" y="0" width="1" height="30" />
                      <rect x="87" y="0" width="3" height="30" />
                      <rect x="92" y="0" width="4" height="30" />
                      <rect x="98" y="0" width="1" height="30" />
                      <rect x="101" y="0" width="3" height="30" />
                      <rect x="106" y="0" width="2" height="30" />
                      <rect x="110" y="0" width="1" height="30" />
                      <rect x="113" y="0" width="4" height="30" />
                      <rect x="119" y="0" width="2" height="30" />
                      <rect x="123" y="0" width="1" height="30" />
                      <rect x="126" y="0" width="3" height="30" />
                      <rect x="131" y="0" width="2" height="30" />
                      <rect x="135" y="0" width="4" height="30" />
                      <rect x="141" y="0" width="1" height="30" />
                      <rect x="144" y="0" width="3" height="30" />
                      <rect x="149" y="0" width="2" height="30" />
                      <rect x="153" y="0" width="3" height="30" />
                      <rect x="158" y="0" width="1" height="30" />
                      <rect x="161" y="0" width="4" height="30" />
                      <rect x="167" y="0" width="2" height="30" />
                      <rect x="171" y="0" width="1" height="30" />
                      <rect x="174" y="0" width="2" height="30" />
                    </svg>
                    <span class="isbn-text font-label text-[0.5rem] tracking-[0.06em] text-charcoal-muted">ISBN 978-0-201-63361-0 • REF: DOM-ARCH-2024-C</span>
                  </div>

                  <div class="verified-seal">
                    <span class="inline-block py-[0.2rem] px-1.5 border border-olive text-olive-dark font-label text-[0.5rem] tracking-[0.14em] uppercase">VERIFIED SPECIMEN</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom Statistics Strip -->
            <div class="stats-strip bg-[rgba(251,249,245,0.85)] border border-hairline py-5 px-4 2xl:py-[1.6rem] 2xl:px-5 max-[640px]:py-4 max-[640px]:px-2.5 grid grid-cols-3 text-center max-[380px]:grid-cols-1 max-[380px]:gap-2.5">
              <div class="stat-col py-0 px-2 border-r border-hairline last:border-r-0 flex flex-col items-center max-[380px]:border-r-0 max-[380px]:border-b max-[380px]:border-hairline max-[380px]:py-1.5 max-[380px]:last:border-b-0 max-[380px]:last:pb-0">
                <span class="stat-number font-headline text-[clamp(1.85rem,2.5vw,2.5rem)] 2xl:text-[3rem] max-[640px]:text-[1.7rem] font-extrabold leading-none text-charcoal">03</span>
                <span class="stat-label font-label text-[0.5625rem] max-[640px]:text-[0.5rem] max-[640px]:tracking-[0.08em] tracking-[0.12em] uppercase font-bold text-charcoal mt-1.5">YEARS IN CRAFT</span>
                <span class="stat-sub font-body italic text-[0.6875rem] max-[640px]:text-[0.625rem] text-charcoal-muted mt-0.5">Staff / Architect</span>
              </div>

              <div class="stat-col py-0 px-2 border-r border-hairline last:border-r-0 flex flex-col items-center max-[380px]:border-r-0 max-[380px]:border-b max-[380px]:border-hairline max-[380px]:py-1.5 max-[380px]:last:border-b-0 max-[380px]:last:pb-0">
                <span class="stat-number font-headline text-[clamp(1.85rem,2.5vw,2.5rem)] 2xl:text-[3rem] max-[640px]:text-[1.7rem] font-extrabold leading-none text-charcoal">100<span class="stat-unit text-base font-sans font-light text-olive-dark">%</span></span>
                <span class="stat-label font-label text-[0.5625rem] max-[640px]:text-[0.5rem] max-[640px]:tracking-[0.08em] tracking-[0.12em] uppercase font-bold text-charcoal mt-1.5">RESPONSIVE WEB</span>
                <span class="stat-sub font-body italic text-[0.6875rem] max-[640px]:text-[0.625rem] text-charcoal-muted mt-0.5">Adaptive Layouts</span>
              </div>

              <div class="stat-col py-0 px-2 border-r border-hairline last:border-r-0 flex flex-col items-center max-[380px]:border-r-0 max-[380px]:border-b max-[380px]:border-hairline max-[380px]:py-1.5 max-[380px]:last:border-b-0 max-[380px]:last:pb-0">
                <span class="stat-number font-headline text-[clamp(1.85rem,2.5vw,2.5rem)] 2xl:text-[3rem] max-[640px]:text-[1.7rem] font-extrabold leading-none text-charcoal">0.0<span class="stat-unit-mono text-sm font-label text-olive-dark">kb</span></span>
                <span class="stat-label font-label text-[0.5625rem] max-[640px]:text-[0.5rem] max-[640px]:tracking-[0.08em] tracking-[0.12em] uppercase font-bold text-charcoal mt-1.5">RUNTIME WASTE</span>
                <span class="stat-sub font-body italic text-[0.6875rem] max-[640px]:text-[0.625rem] text-charcoal-muted mt-0.5">Zero-Lockin Core</span>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { animate, stagger, scroll } from 'motion';

  function initHeroAnimations() {
    const heroWrapper = document.getElementById('cover-feature');
    if (!heroWrapper) return;

    // Responsive sticky curtain effect positioning:
    // On desktop, Hero pins at top: 0 as Atelier slides over it.
    // On small screens (<= 1024px), Hero scrolls naturally through the Left Column and Right Column (Monograph Plate),
    // and only pins once the Monograph Plate has fully scrolled into view / displayed in the Hero section.
    function updateHeroStickyTop() {
      if (!heroWrapper) return;
      if (window.innerWidth > 1024) {
        heroWrapper.style.top = '0px';
      } else {
        const heroHeight = heroWrapper.offsetHeight;
        const vh = window.innerHeight;
        const stickyTop = Math.min(0, vh - heroHeight);
        heroWrapper.style.top = `${stickyTop}px`;
      }
    }

    updateHeroStickyTop();
    window.addEventListener('resize', updateHeroStickyTop, { passive: true });
    window.addEventListener('orientationchange', updateHeroStickyTop, { passive: true });

    if (typeof ResizeObserver !== 'undefined') {
      const resizeObserver = new ResizeObserver(() => {
        updateHeroStickyTop();
      });
      resizeObserver.observe(heroWrapper);
    }

    const heroImg = heroWrapper.querySelector('.plate-image') as HTMLImageElement | null;
    if (heroImg && !heroImg.complete) {
      heroImg.addEventListener('load', updateHeroStickyTop, { once: true });
    }

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      document.documentElement.classList.remove('hero-motion-ready');
      return;
    }

    // Curtain reveal scroll parallax: Scale down from 1 to 0.94 as Technical Atelier slides over it
    const heroInner = document.getElementById('hero-inner-frame');
    const atelierSection = document.getElementById('technical-atelier');
    if (heroInner && atelierSection) {
      scroll(
        animate(heroInner, {
          scale: [1, 0.94],
          opacity: [1, 0.75],
        }),
        {
          target: atelierSection,
          offset: ['start end', 'start start'],
        }
      );
    }

    // Target elements
    const headline = heroWrapper.querySelector('.editorial-headline') as HTMLElement | null;
    const bioHookP = heroWrapper.querySelector('.bio-hook p') as HTMLElement | null;
    const tag = heroWrapper.querySelector('.olive-tag') as HTMLElement | null;
    const thesesBlock = heroWrapper.querySelector('.theses-block') as HTMLElement | null;
    const buttons = Array.from(heroWrapper.querySelectorAll('.actions-strip .btn')) as HTMLElement[];
    const footnote = heroWrapper.querySelector('.editorial-footnote') as HTMLElement | null;
    const monographPlateCol = heroWrapper.querySelector('.monograph-plate-col') as HTMLElement | null;

    // Split text into words and individual character spans for a typing effect without a cursor
    function prepareTyping(container: HTMLElement): HTMLElement[] {
      const existing = container.querySelectorAll('.hero-type-char');
      if (existing.length > 0) {
        return Array.from(existing) as HTMLElement[];
      }

      const chars: HTMLElement[] = [];

      // Preserve accessibility: store full text in aria-label for screen readers
      if (!container.getAttribute('aria-label')) {
        const fullText = container.textContent?.replace(/\s+/g, ' ').trim() || '';
        if (fullText) {
          container.setAttribute('aria-label', fullText);
        }
      }

      function walk(node: Node) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent || '';
          if (!text) return;

          // Ignore pure whitespace text nodes formatting between elements
          if (/^\s+$/.test(text)) {
            return;
          }

          const tokens = text.split(/(\s+)/);
          const frag = document.createDocumentFragment();

          for (const token of tokens) {
            if (!token) continue;
            if (/^\s+$/.test(token)) {
              frag.appendChild(document.createTextNode(token));
            } else {
              const wordSpan = document.createElement('span');
              wordSpan.className = 'hero-type-word';
              wordSpan.setAttribute('aria-hidden', 'true');

              for (const c of Array.from(token)) {
                const charSpan = document.createElement('span');
                charSpan.className = 'hero-type-char';
                charSpan.style.opacity = '0';
                charSpan.textContent = c;
                charSpan.setAttribute('aria-hidden', 'true');
                wordSpan.appendChild(charSpan);
                chars.push(charSpan);
              }
              frag.appendChild(wordSpan);
            }
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const el = node as HTMLElement;
          if (el.classList.contains('hero-type-word') || el.classList.contains('hero-type-char')) {
            return;
          }
          Array.from(node.childNodes).forEach(walk);
        }
      }

      walk(container);
      return chars;
    }

    // Prepare typing structures
    const headlineChars = headline ? prepareTyping(headline) : [];
    const bioChars = bioHookP ? prepareTyping(bioHookP) : [];
    const footnoteChars = footnote ? prepareTyping(footnote) : [];

    // Make containers visible now that inner character spans are at opacity: 0
    if (headline) headline.style.visibility = 'visible';
    if (bioHookP) bioHookP.style.visibility = 'visible';
    if (footnote) footnote.style.visibility = 'visible';

    let hasRun = false;
    let hasScrolledAway = false;
    let currentRunId = 0;
    let activeAnimations: any[] = [];

    function resetAnimations() {
      currentRunId++;
      activeAnimations.forEach((a) => {
        try {
          if (typeof a.cancel === 'function') a.cancel();
          else if (typeof a.stop === 'function') a.stop();
        } catch (_) {}
      });
      activeAnimations = [];

      function clearElementAnim(el: HTMLElement | null) {
        if (el && typeof el.getAnimations === 'function') {
          el.getAnimations().forEach((a) => { try { a.cancel(); } catch (_) {} });
        }
      }

      if (tag) {
        clearElementAnim(tag);
        tag.style.opacity = '0';
        tag.style.transform = 'translateY(8px)';
      }
      if (monographPlateCol) {
        clearElementAnim(monographPlateCol);
        monographPlateCol.style.opacity = '0';
        monographPlateCol.style.transform = 'translateY(20px) scale(0.985)';
      }
      if (thesesBlock) {
        clearElementAnim(thesesBlock);
        thesesBlock.style.opacity = '0';
        thesesBlock.style.transform = 'translateY(16px)';
      }
      buttons.forEach((btn) => {
        clearElementAnim(btn);
        btn.style.opacity = '0';
        btn.style.transform = 'translateY(12px)';
      });
      headlineChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });
      bioChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });
      footnoteChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });

      hasRun = false;
    }

    function playAnimations() {
      if (hasRun) return;
      hasRun = true;
      const runId = ++currentRunId;

      const animations: any[] = [];

      // 1. Tag (DEVELOPER PROFILE & RETROSPECTIVE)
      if (tag) {
        animations.push(
          animate(
            tag,
            { opacity: [0, 1], y: [8, 0] },
            { duration: 0.4, delay: 0.05, ease: [0.16, 1, 0.3, 1] }
          )
        );
      }

      // 2. Heading (Typing effect without typing cursor)
      if (headlineChars.length > 0) {
        animations.push(
          animate(
            headlineChars,
            { opacity: [0, 1] },
            {
              duration: 0.08,
              delay: stagger(0.02, { startDelay: 0.08 }),
              ease: [0.25, 1, 0.5, 1]
            }
          )
        );
      }

      // 3. Right Column: Monograph Plate (Architectural arrival)
      if (monographPlateCol) {
        animations.push(
          animate(
            monographPlateCol,
            { opacity: [0, 1], y: [20, 0], scale: [0.985, 1] },
            {
              duration: 0.9,
              delay: 0.15,
              ease: [0.16, 1, 0.3, 1]
            }
          )
        );
      }

      // 4. Description / Bio Hook (Fluid ink reveal)
      if (bioChars.length > 0) {
        animations.push(
          animate(
            bioChars,
            { opacity: [0, 1] },
            {
              duration: 0.05,
              delay: stagger(0.0035, { startDelay: 0.32 }),
              ease: 'easeOut'
            }
          )
        );
      }

      // 5. Salient Theses and Monograph Outline
      if (thesesBlock) {
        animations.push(
          animate(
            thesesBlock,
            { opacity: [0, 1], y: [16, 0] },
            {
              duration: 0.65,
              delay: 0.38,
              ease: [0.16, 1, 0.3, 1]
            }
          )
        );
      }

      // 6. Action Buttons
      if (buttons.length > 0) {
        animations.push(
          animate(
            buttons,
            { opacity: [0, 1], y: [12, 0] },
            {
              duration: 0.5,
              delay: stagger(0.08, { startDelay: 0.48 }),
              ease: [0.16, 1, 0.3, 1]
            }
          )
        );
      }

      // 7. Editorial Colophon Micro-Stamps
      if (footnoteChars.length > 0) {
        animations.push(
          animate(
            footnoteChars,
            { opacity: [0, 1] },
            {
              duration: 0.04,
              delay: stagger(0.004, { startDelay: 0.52 }),
              ease: 'linear'
            }
          )
        );
      }

      activeAnimations = animations;

      const finishAndCleanStyles = () => {
        if (tag) {
          tag.style.opacity = '1';
          tag.style.removeProperty('transform');
        }
        if (monographPlateCol) {
          monographPlateCol.style.opacity = '1';
          monographPlateCol.style.removeProperty('transform');
        }
        if (thesesBlock) {
          thesesBlock.style.opacity = '1';
          thesesBlock.style.removeProperty('transform');
        }
        buttons.forEach((btn) => {
          btn.style.opacity = '1';
          btn.style.removeProperty('transform');
        });
        headlineChars.forEach((c) => { c.style.opacity = '1'; });
        bioChars.forEach((c) => { c.style.opacity = '1'; });
        footnoteChars.forEach((c) => { c.style.opacity = '1'; });
      };

      // Ensure full visibility upon animation completion
      Promise.allSettled(animations).then(() => {
        if (runId !== currentRunId) return;
        finishAndCleanStyles();
      });

      // Safety fallback: guarantee 100% visibility after 1800ms
      setTimeout(() => {
        if (runId !== currentRunId) return;
        finishAndCleanStyles();
      }, 1800);
    }

    // Play immediately on load
    playAnimations();

    function checkHeroViewport() {
      if (!heroWrapper) return;
      const scrollY = window.scrollY || window.pageYOffset;
      const rect = heroWrapper.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      const isInView = rect.bottom > 80 && rect.top < windowHeight * 0.85;

      if (scrollY > 300) {
        hasScrolledAway = true;
      }

      if (isInView && !hasRun) {
        playAnimations();
      } 
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          checkHeroViewport();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    let resettingScrollAnim = false;
    window.addEventListener('app:reset-scroll-animations', () => {
      hasScrolledAway = false;
      if (resettingScrollAnim) return;

      const triggerIfAtTop = () => {
        const scrollY = window.scrollY || window.pageYOffset;
        if (scrollY <= 120) {
          resettingScrollAnim = false;
          resetAnimations();
          playAnimations();
        } else {
          requestAnimationFrame(triggerIfAtTop);
        }
      };

      resettingScrollAnim = true;
      triggerIfAtTop();
      setTimeout(() => { resettingScrollAnim = false; }, 1200);
    });

    if (typeof IntersectionObserver !== 'undefined') {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasRun) {
            playAnimations();
          }
        });
      }, { threshold: 0.05 });
      observer.observe(heroWrapper);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimations);
  } else {
    initHeroAnimations();
  }
  document.addEventListener('astro:page-load', initHeroAnimations);
</script>
