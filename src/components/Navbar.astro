---
import SealLogo from './SealLogo.astro';

const navLinks = [
  { label: 'Cover Feature', href: '#cover-feature' },
  {  label: 'Technical Atelier', href: '#technical-atelier' },
  {  label: 'Selected Works', href: '#selected-works' },
  {  label: 'Colophon & Inquiries', href: '#colophon-inquiries' },
];
---

<header class="site-header" id="site-header">
  <div class="nav-container">
    <a href="#cover-feature" class="brand-logo" aria-label="Kumghato Khala">
      <SealLogo size={50} class="brand-seal-icon" />
      <span class="brand-name">Kumghato K Khala</span>
    </a>

    <button
      id="mobile-nav-toggle"
      class="nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span class="nav-toggle-text">Menu</span>
      <span class="nav-toggle-bars" aria-hidden="true">
        <span class="bar top-bar"></span>
        <span class="bar bottom-bar"></span>
      </span>
    </button>

    <nav id="primary-navigation" class="nav-menu" aria-label="Main Navigation">
      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li class="nav-item">
              <a href={link.href} class="nav-link" data-nav-link>
                <span class="nav-link-text">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const navMenu = document.getElementById('primary-navigation');
  const toggleText = toggleBtn?.querySelector('.nav-toggle-text');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
  const header = document.getElementById('site-header');

  function toggleMenu(forceClose = false) {
    const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
    const nextState = forceClose ? false : !isExpanded;

    toggleBtn?.setAttribute('aria-expanded', String(nextState));
    navMenu?.classList.toggle('is-open', nextState);
    toggleBtn?.classList.toggle('is-active', nextState);

    if (toggleText) {
      toggleText.textContent = nextState ? 'Close' : 'Menu';
    }
  }

  toggleBtn?.addEventListener('click', () => toggleMenu());

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navMenu?.classList.contains('is-open')) {
      toggleMenu(true);
    }
  });

  // =========================================================================
  // ACTIVE SECTION TRACKING & URL REWRITE
  // =========================================================================
  const SECTION_IDS = [
    'cover-feature',
    'technical-atelier',
    'selected-works',
    'colophon-inquiries',
  ];

  let currentActiveId = '';
  let isProgrammaticScroll = false;
  let programmaticScrollTimer: number | undefined;

  function setActiveSection(id: string, updateUrl = true) {
    if (!id) return;
    currentActiveId = id;
    const targetHref = `#${id}`;

    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      const isActive = href === targetHref;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    if (updateUrl && window.location.hash !== targetHref) {
      history.replaceState(null, '', targetHref);
    }
  }

  function getActiveSectionId(): string {
    const scrollY = window.scrollY || window.pageYOffset;
    const windowHeight = window.innerHeight;
    const scrollHeight = document.documentElement.scrollHeight;

    // Edge case 1: Bottom of page -> activate last section
    if (windowHeight + scrollY >= scrollHeight - 70) {
      return SECTION_IDS[SECTION_IDS.length - 1];
    }

    // Edge case 2: Very top of page -> activate first section
    if (scrollY <= 80) {
      return SECTION_IDS[0];
    }

    const headerHeight = header ? header.offsetHeight : 70;
    const triggerOffset = headerHeight + 110;

    let activeId = SECTION_IDS[0];
    for (const id of SECTION_IDS) {
      const el = document.getElementById(id);
      if (!el) continue;
      const rect = el.getBoundingClientRect();
      if (rect.top <= triggerOffset) {
        activeId = id;
      }
    }

    return activeId;
  }

  let scrollTicking = false;
  function handleScroll() {
    const scrollY = window.scrollY || window.pageYOffset;
    header?.classList.toggle('is-scrolled', scrollY > 20);

    if (isProgrammaticScroll) return;

    if (!scrollTicking) {
      window.requestAnimationFrame(() => {
        const id = getActiveSectionId();
        if (id) {
          setActiveSection(id, true);
        }
        scrollTicking = false;
      });
      scrollTicking = true;
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  window.addEventListener('resize', handleScroll, { passive: true });

  // Cancel manual scroll lock when user scrolls manually with wheel or touch
  window.addEventListener('wheel', () => { isProgrammaticScroll = false; }, { passive: true });
  window.addEventListener('touchmove', () => { isProgrammaticScroll = false; }, { passive: true });

  // Nav link click handling
  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (navMenu?.classList.contains('is-open')) {
        toggleMenu(true);
      }

      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        const targetId = href.slice(1);
        setActiveSection(targetId, true);

        // Lock auto-detection temporarily while smooth scroll animates
        isProgrammaticScroll = true;
        clearTimeout(programmaticScrollTimer);
        programmaticScrollTimer = window.setTimeout(() => {
          isProgrammaticScroll = false;
        }, 900);
      }
    });
  });

  // Brand logo click smoothly scrolls to top and activates cover-feature
  const brandLogo = document.querySelector<HTMLAnchorElement>('.brand-logo');
  brandLogo?.addEventListener('click', () => {
    setActiveSection('cover-feature', true);
  });

  // Initial synchronization on load
  function initNav() {
    const hash = window.location.hash;
    if (hash && hash.startsWith('#')) {
      const targetId = hash.slice(1);
      if (SECTION_IDS.includes(targetId)) {
        setActiveSection(targetId, false);
        return;
      }
    }

    const currentId = getActiveSectionId();
    if (currentId) {
      setActiveSection(currentId, true);
    }
  }

  window.addEventListener('hashchange', () => {
    const hash = window.location.hash;
    if (hash && hash.startsWith('#')) {
      const targetId = hash.slice(1);
      if (SECTION_IDS.includes(targetId)) {
        setActiveSection(targetId, false);
      }
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background-color: rgba(244, 241, 234, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-hairline, rgba(26, 26, 26, 0.16));
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .site-header.is-scrolled {
    background-color: rgba(244, 241, 234, 0.98);
    box-shadow: 0 4px 20px rgba(26, 26, 26, 0.06);
    border-bottom-color: rgba(26, 26, 26, 0.22);
  }

  .nav-container {
     max-width: var(--container-max-width, 1540px);
    margin: 0 auto;
    padding: 1.15rem var(--container-padding, clamp(1.25rem, 3.2vw, 2.5rem));
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-headline, 'Bodoni Moda Variable', 'Bodoni Moda', Georgia, serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-primary, #1a1a1a);
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .brand-seal-icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-name {
    display: inline-block;
  }

  .brand-logo:hover {
    opacity: 0.85;
  }

  .brand-logo:hover .brand-seal-icon {
    transform: rotate(15deg) scale(1.04);
  }

  .brand-logo:focus-visible {
    outline: 2px solid var(--color-secondary, #5A6351);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.75rem;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-secondary, #5A6351);
    text-decoration: none;
    padding: 0.35rem 0;
    position: relative;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .nav-link-num {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--color-olive-dark, #5a6351);
    opacity: 0.8;
  }

  .nav-link-text {
    position: relative;
    display: inline-block;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-primary, #1a1a1a);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-primary, #1a1a1a);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .nav-link.is-active {
    color: var(--color-primary, #1a1a1a);
    font-weight: 700;
  }

  .nav-link.is-active::after {
    transform: scaleX(1);
    transform-origin: left center;
    height: 2px;
    background-color: var(--color-primary, #1a1a1a);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-secondary, #5A6351);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.65rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.4rem 0.5rem;
    color: var(--color-primary, #111110);
    font-family: var(--font-label, 'Space Mono', monospace);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .nav-toggle-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 18px;
    height: 14px;
    position: relative;
  }

  .bar {
    width: 100%;
    height: 1.5px;
    background-color: var(--color-primary, #111110);
    position: absolute;
    left: 0;
    transition: transform 0.25s ease, top 0.25s ease, opacity 0.2s ease;
  }

  .top-bar {
    top: 3px;
  }

  .bottom-bar {
    top: 9px;
  }

  .nav-toggle.is-active .top-bar {
    top: 6px;
    transform: rotate(45deg);
  }

  .nav-toggle.is-active .bottom-bar {
    top: 6px;
    transform: rotate(-45deg);
  }

  @media (min-width: 2560px) {
    .nav-container {
      padding: 1.6rem var(--container-padding);
    }

    .brand-logo {
      font-size: 1.75rem;
      gap: 1rem;
    }

    .brand-seal-icon {
      width: 42px;
      height: 42px;
    }

    .nav-list {
      gap: 2.5rem;
    }

    .nav-link {
      font-size: 0.85rem;
    }

    .nav-link-num {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 992px) {
    .nav-container {
      padding: 1rem var(--container-padding, 1.25rem);
    }

    .nav-toggle {
      display: flex;
    }

    .nav-menu {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      max-height: calc(100vh - 65px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background-color: var(--color-neutral, #F9F8F5);
      border-bottom: 1px solid rgba(90, 99, 81, 0.2);
      padding: 1.5rem 1.5rem 2rem;
      display: none;
      flex-direction: column;
      align-items: flex-start;
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.06);
    }

    .nav-menu.is-open {
      display: flex;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      width: 100%;
    }

    .nav-item {
      width: 100%;
    }

    .nav-link {
      font-size: 0.95rem;
      width: 100%;
      padding: 0.65rem 0.5rem;
      border-bottom: 1px solid rgba(90, 99, 81, 0.12);
      display: block;
      transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, padding-left 0.2s ease;
    }

    .nav-link::after {
      display: none;
    }

    .nav-link.is-active {
      color: var(--color-primary, #1a1a1a);
      font-weight: 700;
      border-bottom: 2px solid var(--color-primary, #1a1a1a);
      background-color: rgba(90, 99, 81, 0.06);
      padding-left: 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .brand-logo {
      font-size: 1.15rem;
      gap: 0.55rem;
    }

    .brand-seal-icon {
      width: 28px;
      height: 28px;
    }
  }

  @media (max-width: 480px) {
    .nav-container {
      padding: 0.85rem 1rem;
    }

    .brand-logo {
      font-size: 1.05rem;
      gap: 0.5rem;
    }

    .brand-seal-icon {
      width: 26px;
      height: 26px;
    }

    .nav-toggle {
      font-size: 0.72rem;
      padding: 0.35rem 0.4rem;
    }
  }

  @media (max-width: 360px) {
    .nav-container {
      padding: 0.75rem 0.75rem;
    }

    .brand-logo {
      font-size: 0.95rem;
      gap: 0.35rem;
    }

    .brand-seal-icon {
      width: 22px;
      height: 22px;
    }

    .nav-toggle-text {
      font-size: 0.6875rem;
    }
  }
</style>
