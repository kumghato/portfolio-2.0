---
import SealLogo from './SealLogo.astro';

const navLinks = [
  { label: 'Cover Feature', href: '#cover-feature' },
  { label: 'Technical Atelier', href: '#technical-atelier' },
  { label: 'Selected Works', href: '#selected-works' },
  { label: 'Colophon & Inquiries', href: '#colophon-inquiries' },
];
---

<header class="site-header sticky top-0 left-0 w-full z-50 bg-[#f4f1ea]/95 backdrop-blur-md border-b border-hairline transition-all duration-200 [&.is-scrolled]:bg-[#f4f1ea]/98 [&.is-scrolled]:shadow-sm" id="site-header">
  <div class="nav-container max-w-[var(--container-max-width,1540px)] mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[68px] flex justify-between items-center">
    <a href="#cover-feature" class="brand-logo group inline-flex items-center gap-2.5 font-headline text-lg sm:text-xl font-bold tracking-tight text-primary no-underline transition-opacity duration-200 whitespace-nowrap hover:opacity-85" aria-label="Kumghato Khala">
      <SealLogo size={32} class="brand-seal-icon shrink-0 transition-transform duration-300 ease-out group-hover:rotate-12 group-hover:scale-105" />
      <span class="brand-name inline-block">Kumghato K Khala</span>
    </a>

    <button
      id="mobile-nav-toggle"
      class="nav-toggle flex lg:hidden items-center gap-2 bg-transparent border-0 cursor-pointer py-1.5 px-2 text-primary font-label text-xs uppercase tracking-wider"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span class="nav-toggle-text text-xs">Menu</span>
      <span class="nav-toggle-bars flex flex-col justify-center w-[18px] h-[14px] relative" aria-hidden="true">
        <span class="bar top-bar w-full h-[1.5px] bg-primary absolute left-0 top-[3px] transition-all duration-200 [.nav-toggle.is-active_&]:top-[6px] [.nav-toggle.is-active_&]:rotate-45"></span>
        <span class="bar bottom-bar w-full h-[1.5px] bg-primary absolute left-0 top-[9px] transition-all duration-200 [.nav-toggle.is-active_&]:top-[6px] [.nav-toggle.is-active_&]:-rotate-45"></span>
      </span>
    </button>

    <nav id="primary-navigation" class="nav-menu hidden lg:flex items-center max-lg:[&.is-open]:flex max-lg:[&.is-open]:flex-col max-lg:[&.is-open]:absolute max-lg:[&.is-open]:top-full max-lg:[&.is-open]:left-0 max-lg:[&.is-open]:w-full max-lg:[&.is-open]:bg-[#f4f1ea] max-lg:[&.is-open]:border-b max-lg:[&.is-open]:border-hairline max-lg:[&.is-open]:p-6 max-lg:[&.is-open]:shadow-xl" aria-label="Main Navigation">
      <ul class="nav-list flex items-center list-none m-0 p-0 gap-6 lg:gap-8 max-lg:flex-col max-lg:items-start max-lg:gap-4 max-lg:w-full">
        {
          navLinks.map((link) => (
            <li class="nav-item inline-flex items-center max-lg:w-full">
              <a href={link.href} class="nav-link font-label text-[0.72rem] font-medium tracking-widest uppercase text-secondary no-underline py-1 relative transition-colors duration-200 inline-flex items-baseline gap-1.5 hover:text-primary max-lg:text-sm max-lg:w-full max-lg:py-2.5 max-lg:border-b max-lg:border-hairline/40" data-nav-link>
                <span class="nav-link-text relative inline-block">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Seal logo sizing for navbar */
  .brand-seal-icon {
    width: 28px;
    height: 28px;
    max-width: 28px;
    max-height: 28px;
  }

  @media (min-width: 640px) {
    .brand-seal-icon {
      width: 32px;
      height: 32px;
      max-width: 32px;
      max-height: 32px;
    }
  }

  /* Nav Links & Underline Active State */
  .nav-link {
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link-text {
    position: relative;
    display: inline-block;
    padding-bottom: 4px;
  }

  /* Animated underline indicator */
  .nav-link-text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0px;
    width: 100%;
    height: 2px;
    background-color: var(--color-primary, #1a1a1a);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    opacity: 0;
    pointer-events: none;
  }

  /* Hover state: subtle preview underline */
  .nav-link:hover {
    color: var(--color-primary, #1a1a1a);
  }

  .nav-link:hover .nav-link-text::after {
    transform: scaleX(0.5);
    opacity: 0.45;
  }

  /* Active state: bold & full underline */
  .nav-link.is-active {
    color: var(--color-primary, #1a1a1a) !important;
    font-weight: 700;
  }

  .nav-link.is-active .nav-link-text::after {
    transform: scaleX(1) !important;
    opacity: 1 !important;
    background-color: var(--color-primary, #1a1a1a);
  }

  @media (max-width: 1023px) {
    .nav-link.is-active {
      background-color: rgba(26, 26, 26, 0.04);
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      border-radius: 2px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const navMenu = document.getElementById('primary-navigation');
  const toggleText = toggleBtn?.querySelector('.nav-toggle-text');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
  const header = document.getElementById('site-header');

  function toggleMenu(forceClose = false) {
    const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
    const nextState = forceClose ? false : !isExpanded;

    toggleBtn?.setAttribute('aria-expanded', String(nextState));
    navMenu?.classList.toggle('is-open', nextState);
    toggleBtn?.classList.toggle('is-active', nextState);

    if (toggleText) {
      toggleText.textContent = nextState ? 'Close' : 'Menu';
    }
  }

  toggleBtn?.addEventListener('click', () => toggleMenu());

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navMenu?.classList.contains('is-open')) {
      toggleMenu(true);
    }
  });

  // =========================================================================
  // ACTIVE SECTION TRACKING & URL REWRITE
  // =========================================================================
  const SECTION_IDS = [
    'cover-feature',
    'technical-atelier',
    'selected-works',
    'colophon-inquiries',
  ];

  let currentActiveId = '';
  let isProgrammaticScroll = false;
  let programmaticScrollTimer: number | undefined;

  function setActiveSection(id: string, updateUrl = true) {
    if (!id) return;
    currentActiveId = id;
    const targetHref = `#${id}`;

    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      const isActive = href === targetHref;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    if (updateUrl && window.location.hash !== targetHref) {
      history.replaceState(null, '', targetHref);
    }
  }

  function getActiveSectionId(): string {
    const scrollY = window.scrollY || window.pageYOffset;
    const windowHeight = window.innerHeight;
    const scrollHeight = document.documentElement.scrollHeight;

    // Edge case 1: Bottom of page -> activate last section
    if (windowHeight + scrollY >= scrollHeight - 70) {
      return SECTION_IDS[SECTION_IDS.length - 1];
    }

    // Edge case 2: Very top of page -> activate first section
    if (scrollY <= 80) {
      return SECTION_IDS[0];
    }

    const headerHeight = header ? header.offsetHeight : 70;
    const triggerOffset = headerHeight + 110;

    let activeId = SECTION_IDS[0];
    for (const id of SECTION_IDS) {
      const el = document.getElementById(id);
      if (!el) continue;
      const rect = el.getBoundingClientRect();
      if (rect.top <= triggerOffset) {
        activeId = id;
      }
    }

    return activeId;
  }

  let scrollTicking = false;
  function handleScroll() {
    const scrollY = window.scrollY || window.pageYOffset;
    header?.classList.toggle('is-scrolled', scrollY > 20);

    if (isProgrammaticScroll) return;

    if (!scrollTicking) {
      window.requestAnimationFrame(() => {
        const id = getActiveSectionId();
        if (id) {
          setActiveSection(id, true);
        }
        scrollTicking = false;
      });
      scrollTicking = true;
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  window.addEventListener('resize', handleScroll, { passive: true });

  // Cancel manual scroll lock when user scrolls manually with wheel or touch
  window.addEventListener('wheel', () => { isProgrammaticScroll = false; }, { passive: true });
  window.addEventListener('touchmove', () => { isProgrammaticScroll = false; }, { passive: true });

  // =========================================================================
  // SMOOTH NAVIGATION (HANDLING STICKY HERO & SECTIONS)
  // =========================================================================
  function scrollToCoverFeature(updateUrl = true) {
    if (navMenu?.classList.contains('is-open')) {
      toggleMenu(true);
    }

    isProgrammaticScroll = true;
    clearTimeout(programmaticScrollTimer);
    programmaticScrollTimer = window.setTimeout(() => {
      isProgrammaticScroll = false;
    }, 1000);

    setActiveSection('cover-feature', updateUrl);

    // Smoothly scroll the window to the very top to reveal sticky cover-feature
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    });

    // Notify hero component to reset and replay entrance animation once reached
    const checkTop = () => {
      const scrollY = window.scrollY || window.pageYOffset;
      if (scrollY <= 120) {
        window.dispatchEvent(new CustomEvent('app:reset-scroll-animations'));
      } else if (isProgrammaticScroll) {
        requestAnimationFrame(checkTop);
      }
    };
    requestAnimationFrame(checkTop);
  }

  function navigateToSection(targetId: string, updateUrl = true) {
    if (targetId === 'cover-feature') {
      scrollToCoverFeature(updateUrl);
      return;
    }

    const targetEl = document.getElementById(targetId);
    if (!targetEl) return;

    if (navMenu?.classList.contains('is-open')) {
      toggleMenu(true);
    }

    setActiveSection(targetId, updateUrl);

    isProgrammaticScroll = true;
    clearTimeout(programmaticScrollTimer);
    programmaticScrollTimer = window.setTimeout(() => {
      isProgrammaticScroll = false;
    }, 1000);

    const headerHeight = header ? header.offsetHeight : 68;
    const targetTop = targetEl.getBoundingClientRect().top + window.scrollY - headerHeight;
    window.scrollTo({
      top: Math.max(0, targetTop),
      behavior: 'smooth',
    });
  }

  // Intercept all links targeting #cover-feature (brand logo, colophon link, etc.)
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('a[href="#cover-feature"]');
    if (target) {
      e.preventDefault();
      scrollToCoverFeature(true);
    }
  });

  // Nav link click handling
  navLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        const targetId = href.slice(1);
        if (SECTION_IDS.includes(targetId)) {
          e.preventDefault();
          navigateToSection(targetId, true);
        }
      }
    });
  });

  // Initial synchronization on load
  function initNav() {
    const hash = window.location.hash;
    if (hash && hash.startsWith('#')) {
      const targetId = hash.slice(1);
      if (targetId === 'cover-feature') {
        scrollToCoverFeature(false);
        return;
      }
      if (SECTION_IDS.includes(targetId)) {
        setActiveSection(targetId, false);
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          const headerHeight = header ? header.offsetHeight : 68;
          const targetTop = targetEl.getBoundingClientRect().top + window.scrollY - headerHeight;
          window.scrollTo({
            top: Math.max(0, targetTop),
            behavior: 'instant',
          });
        }
        return;
      }
    }

    const currentId = getActiveSectionId();
    if (currentId) {
      setActiveSection(currentId, false);
    }
  }

  window.addEventListener('hashchange', () => {
    const hash = window.location.hash;
    if (hash === '#cover-feature') {
      scrollToCoverFeature(false);
    } else if (hash && hash.startsWith('#')) {
      const targetId = hash.slice(1);
      if (SECTION_IDS.includes(targetId)) {
        navigateToSection(targetId, false);
      }
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>
