<script is:inline>
  if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('atelier-motion-ready');
  }
</script>

<section 
  class="foundry-metrics-wrapper relative z-20 min-h-screen w-full bg-editorial-bg shadow-[0_-25px_60px_rgba(26,26,26,0.15)] border-t border-hairline scroll-mt-[72px]" 
  id="technical-atelier" 
  aria-labelledby="atelier-heading"
>
  <!-- Architectural Top Framing Hairline Strip -->
  <div class="atelier-sub-bar" aria-label="Atelier Monograph Technical Registry">
    <div class="atelier-container">
      <div class="meta-grid">
        <div class="meta-item meta-title">
          <span class="meta-strong">SECTION 02</span>
          <span class="meta-divider">—</span>
          <span>FOUNDRY METRICS REGISTRY</span>
        </div>

        <div class="meta-item meta-disciplines">
          <span class="meta-label">DISCIPLINES:</span>
          <span class="meta-strong">09 SYSTEM PLATES</span>
        </div>

        <div class="meta-item meta-standards">
          <span class="meta-label">STANDARDS:</span>
          <span class="meta-strong">TYPE-SAFE • ZERO-BLOAT</span>
        </div>

        <div class="meta-item meta-status">
          <span class="meta-label">STATUS:</span>
          <span class="meta-badge-pulse">PRODUCTION GRADE</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Atelier Content Container -->
  <div class="atelier-main-body">
    <div class="atelier-container">

      <!-- ========================================== -->
      <!-- SECTION HEADER: HIGH-CONTRAST DIDONE SERIF -->
      <!-- ========================================== -->
      <div class="atelier-header-block">
        <div class="header-left">
          <!-- Subhead Tag -->
          <div class="tag-row">
            <span class="olive-tag">
              <span class="tag-dot" aria-hidden="true"></span>
              SECTION 02 // FOUNDRY METRICS
            </span>
          </div>

          <!-- Main Headline -->
          <h2 id="atelier-heading" class="atelier-headline">
            THE TECHNICAL ATELIER
          </h2>

          <div class="header-sub-tagline">
            <span>ARCHITECTURAL INVENTORY &amp; CORE STACK PROFICIENCY</span>
          </div>
        </div>

        <!-- Accompanying Italicized Editorial Aside -->
        <div class="header-right">
          <blockquote class="editorial-aside border-l-2 border-olive">
            <p>
              “A high-performance web engineering stack. Building modern, type-safe applications with clean codebases, scalable database layers, and fluid cross-device execution.”
            </p>
          </blockquote>
        </div>
      </div>


      <!-- ========================================== -->
      <!-- THE INTERACTIVE 3D IMAGE WHEEL STAGE       -->
      <!-- ========================================== -->
      <div class="wheel-view-container" id="wheel-view-wrapper">
        
        <div class="wheel-stage-wrapper">
          
          <!-- Instructions overlay hint -->
          <div class="wheel-interaction-hint" aria-hidden="true">
            <span class="hint-arrow">←</span>
            <span>CLICK ADJACENT PLATES OR DRAG TO ROTATE // INTERACTIVE 3D DEPTH</span>
            <span class="hint-arrow">→</span>
          </div>

          <!-- The 3D Stage -->
          <div 
            class="wheel-3d-stage" 
            id="wheel-stage" 
            role="region" 
            aria-label="3D Technical Atelier Image Wheel"
            tabindex="0"
          >
            <!-- Circular Ground Orbit Markings (Floor Turntable) -->
            <div class="wheel-ground-orbit" aria-hidden="true">
              <div class="orbit-ring outer"></div>
              <div class="orbit-ring inner"></div>
              <div class="orbit-cross cross-h"></div>
              <div class="orbit-cross cross-v"></div>
              <div class="orbit-center-pin"></div>
            </div>

            <!-- The Rotating Cylinder containing the 9 Plates -->
            <div class="wheel-cylinder" id="wheel-cylinder">
              {plates.map((plate, index) => (
                <article 
                  class={`wheel-card ${index === 0 ? 'is-active-front' : index === 1 ? 'is-flanking is-flanking-next' : index === 8 ? 'is-flanking is-flanking-prev' : 'is-distant'}`}
                  data-index={index}
                  style={`--accent-color: ${plate.accentColor};`}
                >
                  <!-- Flanking Navigation Cues -->
                  <div class="card-flank-cue flank-cue-prev" aria-hidden="true">
                    <span class="cue-arrow">←</span>
                    <span class="cue-label">PREV</span>
                  </div>
                  <div class="card-flank-cue flank-cue-next" aria-hidden="true">
                    <span class="cue-label">NEXT</span>
                    <span class="cue-arrow">→</span>
                  </div>

                  <div class="wheel-card-inner">
                    <!-- Specular Glare Layer -->
                    <div class="card-glare" aria-hidden="true"></div>

                    <!-- Corner Architectural Marks -->
                    <span class="card-corner top-left" aria-hidden="true">⌜</span>
                    <span class="card-corner top-right" aria-hidden="true">⌝</span>
                    <span class="card-corner bottom-left" aria-hidden="true">⌞</span>
                    <span class="card-corner bottom-right" aria-hidden="true">⌟</span>

                    <!-- Card Header: Mini Status -->
                    <div class="card-header">
                      <span class="card-mini-badge">{plate.statusBadge}</span>
                    </div>

                    <!-- Central Image Frame: Authentic SVG from Assets folder -->
                    <div class="card-image-pedestal">
                      <div class="pedestal-halo" aria-hidden="true"></div>
                      <img 
                        src={plate.assetFile} 
                        alt={`${plate.name} logo`} 
                        class="card-tech-image" 
                        loading="eager"
                        draggable="false"
                      />
                    </div>

                    <!-- Card Title (Skill name only) -->
                    <div class="card-content">
                      <h3 class="card-title">{plate.name}</h3>
                    </div>
                   
                  </div>
                </article>
              ))}
            </div>
          </div>

          <!-- Wheel Center Counter & Navigation Controls -->
          <div class="wheel-controls-strip">
            <button 
              type="button" 
              class="wheel-nav-btn prev" 
              id="wheel-btn-prev" 
              aria-label="Previous specimen plate"
            >
              <span class="nav-arrow" aria-hidden="true">←</span>
              <span class="nav-text">PREV</span>
            </button>

            <button 
              type="button" 
              class="wheel-nav-btn next" 
              id="wheel-btn-next" 
              aria-label="Next specimen plate"
            >
              <span class="nav-text">NEXT</span>
              <span class="nav-arrow" aria-hidden="true">→</span>
            </button>
          </div>

          <!-- Quick Navigation Bar: 9 Plate Pills -->
          <div class="wheel-pagination-strip" role="tablist" aria-label="Jump to specific plate">
            {plates.map((plate, index) => (
              <button
                type="button"
                class={`pagination-pill ${index === 0 ? 'is-active' : ''}`}
                data-target-index={index}
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-label={`View ${plate.name}`}
              >
                <span class="pill-num">0{index + 1}</span>
                <span class="pill-name">{plate.shortName}</span>
              </button>
            ))}
          </div>
        </div>

      </div>

 

    </div>
  </div>
</section>

<!-- JSON Serialized Plates Data for Client Scripts -->
<script type="application/json" id="plates-json" set:html={JSON.stringify(plates)} />

<!-- ========================================== -->
<!-- CLIENT SCRIPT: MOTION IMAGE WHEEL & 3D TILT-->
<!-- ========================================== -->
<script>
  import { animate, stagger, inView } from 'motion';

  // Read data
  const platesDataElement = document.getElementById('plates-json');
  const platesData = platesDataElement ? JSON.parse(platesDataElement.textContent || '[]') : [];
  const TOTAL_PLATES = platesData.length || 9;
  const STEP_DEGREES = 360 / TOTAL_PLATES; // 40 degrees

  // Elements
  const stage = document.getElementById('wheel-stage');
  const cylinder = document.getElementById('wheel-cylinder');
  const cards = Array.from(document.querySelectorAll('.wheel-card')) as HTMLElement[];
  const paginationPills = Array.from(document.querySelectorAll('.pagination-pill')) as HTMLElement[];
  const prevBtn = document.getElementById('wheel-btn-prev');
  const nextBtn = document.getElementById('wheel-btn-next');

  // Kinematic State
  let currentRotation = 0;
  let activeIndex = 0;
  let animControls: any = null;
  const isAutoSpinning = true; // Auto-spin active by default
  let autoTimer: any = null;

  // Compute 3D Radius responsive to viewport
  function computeRadius(): number {
    const width = window.innerWidth;
    if (width < 380) return 240;
    if (width < 480) return 265;
    if (width < 768) return 305;
    if (width < 1024) return 340;
    if (width >= 2560) return 480;
    return 380;
  }

  let currentRadius = computeRadius();

  // Position cards in 3D circular cylinder
  function positionCards() {
    currentRadius = computeRadius();
    cards.forEach((card, idx) => {
      const angle = idx * STEP_DEGREES;
      card.style.transform = `rotateY(${angle}deg) translateZ(${currentRadius}px)`;
    });
  }

  // Apply cylinder rotation and calculate angular perspective/focus
  function applyRotation(rot: number) {
    if (!cylinder) return;
    cylinder.style.transform = `rotateX(-3.5deg) rotateY(${rot}deg)`;

    // Calculate normalized active index facing the camera
    const normalized = ((-rot % 360) + 360) % 360;
    const currIdx = (Math.round(normalized / STEP_DEGREES) % TOTAL_PLATES + TOTAL_PLATES) % TOTAL_PLATES;

    // Update each card's visual depth & flanking directions
    cards.forEach((card, idx) => {
      let diff = (idx * STEP_DEGREES - (-rot)) % 360;
      if (diff > 180) diff -= 360;
      if (diff < -180) diff += 360;
      const absDiff = Math.abs(diff);

      if (absDiff < 20) {
        card.classList.add('is-active-front');
        card.classList.remove('is-flanking', 'is-flanking-prev', 'is-flanking-next', 'is-distant');
        card.style.opacity = '1';
        card.style.zIndex = '30';
      } else if (absDiff < 65) {
        card.classList.remove('is-active-front', 'is-distant');
        card.classList.add('is-flanking');
        if (diff < 0) {
          card.classList.add('is-flanking-prev');
          card.classList.remove('is-flanking-next');
          card.setAttribute('aria-label', `Previous specimen plate: ${platesData[idx]?.name || ''}`);
        } else {
          card.classList.add('is-flanking-next');
          card.classList.remove('is-flanking-prev');
          card.setAttribute('aria-label', `Next specimen plate: ${platesData[idx]?.name || ''}`);
        }
        card.style.opacity = '0.78';
        card.style.zIndex = '15';
      } else {
        card.classList.remove('is-active-front', 'is-flanking', 'is-flanking-prev', 'is-flanking-next');
        card.classList.add('is-distant');
        const depthOpacity = Math.max(0.18, 0.52 - (absDiff / 180) * 0.38);
        card.style.opacity = depthOpacity.toFixed(2);
        card.style.zIndex = '5';
      }
    });

    if (currIdx !== activeIndex) {
      activeIndex = currIdx;
      updateActiveSpecimen(activeIndex);
    }
  }

  // Smooth Motion Kinematics
  function animateToAngle(targetAngle: number, duration: number = 0.8) {
    if (animControls) {
      animControls.stop();
      animControls = null;
    }
    const startAngle = currentRotation;
    animControls = animate(startAngle, targetAngle, {
      duration,
      ease: [0.16, 1, 0.3, 1], // Architectural spring-like cubic bezier
      onUpdate: (latest: number) => {
        currentRotation = latest;
        applyRotation(currentRotation);
      }
    });
  }

  // Direct rotation to a specific plate index (shortest path)
  function rotateToPlate(targetIndex: number) {
    const currentNorm = ((-currentRotation % 360) + 360) % 360;
    const targetNorm = targetIndex * STEP_DEGREES;
    let diff = targetNorm - currentNorm;
    if (diff > 180) diff -= 360;
    if (diff < -180) diff += 360;
    const targetAngle = currentRotation - diff;
    animateToAngle(targetAngle, 0.85);
  }

  // Update synchronized active specimen status & pills
  let lastActiveIdx = -1;
  function updateActiveSpecimen(idx: number) {
    if (idx === lastActiveIdx) return;
    lastActiveIdx = idx;
    const specimen = platesData[idx];
    if (!specimen) return;

    // Update Quick Nav Pills
    paginationPills.forEach((pill, i) => {
      const isSelected = i === idx;
      pill.classList.toggle('is-active', isSelected);
      pill.setAttribute('aria-selected', isSelected ? 'true' : 'false');
    });
  }

  // Ambient Auto-Spin kinematics (runs by default)
  function startAutoSpin() {
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = setInterval(() => {
      if (isAutoSpinning && !isDragging) {
        const nextTarget = currentRotation - STEP_DEGREES;
        animateToAngle(nextTarget, 1.1);
      }
    }, 4200);
  }

  function pauseAutoSpin() {
    if (autoTimer) {
      clearInterval(autoTimer);
      autoTimer = null;
    }
  }

  // Pointer / Touch Gestures Dragging vs Clicking
  let isPointerDown = false;
  let isDragging = false;
  let wasDragging = false;
  let pointerStartX = 0;
  let pointerStartY = 0;
  let dragStartRotation = 0;
  let lastClientX = 0;
  let lastTimestamp = 0;
  let dragVelocity = 0;
  const DRAG_THRESHOLD = 7; // Pixels to distinguish click from drag

  if (stage) {
    stage.addEventListener('pointerdown', (e: PointerEvent) => {
      // Allow primary pointer only
      if (e.pointerType === 'mouse' && e.button !== 0) return;

      isPointerDown = true;
      isDragging = false;
      pointerStartX = e.clientX;
      pointerStartY = e.clientY;
      dragStartRotation = currentRotation;
      lastClientX = e.clientX;
      lastTimestamp = performance.now();
      dragVelocity = 0;

      pauseAutoSpin();
    });

    stage.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isPointerDown) return;

      const deltaX = e.clientX - pointerStartX;
      const deltaY = e.clientY - pointerStartY;
      const dist = Math.hypot(deltaX, deltaY);

      if (!isDragging && dist > DRAG_THRESHOLD) {
        isDragging = true;
        stage.classList.add('is-dragging');
        if (animControls) {
          animControls.stop();
          animControls = null;
        }
        try {
          stage.setPointerCapture(e.pointerId);
        } catch (_) {}
      }

      if (isDragging) {
        const now = performance.now();
        const dt = now - lastTimestamp;
        if (dt > 0) {
          dragVelocity = (e.clientX - lastClientX) / dt;
        }
        lastClientX = e.clientX;
        lastTimestamp = now;

        currentRotation = dragStartRotation + deltaX * 0.36;
        applyRotation(currentRotation);
      }
    });

    const handlePointerUp = (e: PointerEvent) => {
      if (!isPointerDown) return;
      isPointerDown = false;

      if (isDragging) {
        isDragging = false;
        wasDragging = true;
        setTimeout(() => { wasDragging = false; }, 80);

        stage.classList.remove('is-dragging');
        try {
          if (stage.hasPointerCapture(e.pointerId)) {
            stage.releasePointerCapture(e.pointerId);
          }
        } catch (_) {}

        // Calculate inertia release
        const momentumTarget = currentRotation + dragVelocity * 140;
        const snapped = Math.round(momentumTarget / STEP_DEGREES) * STEP_DEGREES;
        animateToAngle(snapped, 0.75);

        if (isAutoSpinning) {
          startAutoSpin();
        }
      } else {
        // Pure click: do NOT snap back, click handler will execute
        if (isAutoSpinning) {
          startAutoSpin();
        }
      }
    };

    stage.addEventListener('pointerup', handlePointerUp);
    stage.addEventListener('pointercancel', handlePointerUp);

    // Pause auto-spin on hover, resume on leave
    stage.addEventListener('mouseenter', pauseAutoSpin);
    stage.addEventListener('mouseleave', () => {
      if (isAutoSpinning && !isDragging) {
        startAutoSpin();
      }
    });

    // Delegated click handler on stage to catch card clicks
    stage.addEventListener('click', (e: MouseEvent) => {
      if (isDragging || wasDragging) return;
      const cardEl = (e.target as HTMLElement).closest('.wheel-card') as HTMLElement;
      if (cardEl) {
        const idx = parseInt(cardEl.getAttribute('data-index') || '-1', 10);
        if (idx >= 0 && idx < TOTAL_PLATES) {
          pauseAutoSpin();
          rotateToPlate(idx);
          if (isAutoSpinning) startAutoSpin();
        }
      }
    });
  }

  // =========================================================================
  // 3D CARD CURSOR TRACKING: LISTEN TO CURSOR MOVEMENT (LEFT, RIGHT, UP, DOWN)
  // =========================================================================
  cards.forEach((card, idx) => {
    const cardInner = card.querySelector('.wheel-card-inner') as HTMLElement;
    if (!cardInner) return;

    let rafId: number | null = null;
    let targetTiltX = 0;
    let targetTiltY = 0;
    let targetGlareX = 50;
    let targetGlareY = 50;

    const handleCardPointerMove = (e: PointerEvent) => {
      // Avoid tilt fighting when user is actively dragging the carousel
      if (isDragging) return;

      const rect = card.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      // Normalized coordinates from -1 to 1 (-1 = left/top, +1 = right/bottom)
      const normX = ((mouseX / rect.width) - 0.5) * 2;
      const normY = ((mouseY / rect.height) - 0.5) * 2;

      // Maximum tilt angles in degrees - refined for subtle, luxury tactile feedback
      const MAX_TILT_X = 14; // Pitch on horizontal axis (Up / Down)
      const MAX_TILT_Y = 16; // Yaw on vertical axis (Left / Right)

      // Directional 3D response
      targetTiltX = -normY * MAX_TILT_X;
      targetTiltY = normX * MAX_TILT_Y;

      targetGlareX = (mouseX / rect.width) * 100;
      targetGlareY = (mouseY / rect.height) * 100;

      card.classList.remove('is-leaving');

      if (!rafId) {
        rafId = requestAnimationFrame(() => {
          cardInner.style.setProperty('--card-tilt-x', `${targetTiltX.toFixed(2)}deg`);
          cardInner.style.setProperty('--card-tilt-y', `${targetTiltY.toFixed(2)}deg`);
          cardInner.style.setProperty('--card-lift-z', '14px');
          cardInner.style.setProperty('--glare-x', `${targetGlareX.toFixed(1)}%`);
          cardInner.style.setProperty('--glare-y', `${targetGlareY.toFixed(1)}%`);
          cardInner.style.setProperty('--glare-opacity', '0.5');
          rafId = null;
        });
      }
    };

    const handleCardPointerLeave = () => {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      card.classList.add('is-leaving');
      cardInner.style.setProperty('--card-tilt-x', '0deg');
      cardInner.style.setProperty('--card-tilt-y', '0deg');
      cardInner.style.setProperty('--card-lift-z', '0px');
      cardInner.style.setProperty('--glare-opacity', '0');
    };

    const handleCardPointerEnter = (e: PointerEvent) => {
      card.classList.remove('is-leaving');
      handleCardPointerMove(e);
    };

    // Card Cursor movement event listeners
    card.addEventListener('pointermove', handleCardPointerMove);
    card.addEventListener('pointerenter', handleCardPointerEnter);
    card.addEventListener('pointerleave', handleCardPointerLeave);

    // Click direct card on wheel to bring it to front (handles next, prev, or any plate)
    card.addEventListener('click', (e) => {
      if (isDragging || wasDragging) return;
      e.stopPropagation();
      pauseAutoSpin();
      rotateToPlate(idx);
      if (isAutoSpinning) startAutoSpin();
    });
  });

  // Previous & Next navigation buttons
  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    pauseAutoSpin();
    const targetIdx = (activeIndex - 1 + TOTAL_PLATES) % TOTAL_PLATES;
    rotateToPlate(targetIdx);
    if (isAutoSpinning) startAutoSpin();
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    pauseAutoSpin();
    const targetIdx = (activeIndex + 1) % TOTAL_PLATES;
    rotateToPlate(targetIdx);
    if (isAutoSpinning) startAutoSpin();
  });

  // Pagination Quick Jump
  paginationPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pauseAutoSpin();
      const targetIdx = parseInt(pill.getAttribute('data-target-index') || '0', 10);
      rotateToPlate(targetIdx);
      if (isAutoSpinning) startAutoSpin();
    });
  });

  // Handle Resize
  window.addEventListener('resize', () => {
    positionCards();
    applyRotation(currentRotation);
  });

  // Keyboard navigation
  stage?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft') {
      pauseAutoSpin();
      rotateToPlate((activeIndex - 1 + TOTAL_PLATES) % TOTAL_PLATES);
      if (isAutoSpinning) startAutoSpin();
    } else if (e.key === 'ArrowRight') {
      pauseAutoSpin();
      rotateToPlate((activeIndex + 1) % TOTAL_PLATES);
      if (isAutoSpinning) startAutoSpin();
    }
  });

  // Initialize
  positionCards();
  applyRotation(0);
  updateActiveSpecimen(0);
  if (isAutoSpinning) {
    startAutoSpin();
  }

  // =========================================================================
  // ATELIER ENTRANCE & TYPING ANIMATIONS (Matching Editorial Hero)
  // =========================================================================
  function initAtelierAnimations() {
    const atelierWrapper = document.getElementById('technical-atelier');
    if (!atelierWrapper) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      document.documentElement.classList.remove('atelier-motion-ready');
      return;
    }

    // Target elements
    const headerBlock = atelierWrapper.querySelector('.atelier-header-block') as HTMLElement | null;
    const headline = atelierWrapper.querySelector('.atelier-headline') as HTMLElement | null;
    const subTagline = atelierWrapper.querySelector('.header-sub-tagline') as HTMLElement | null;
    const asideP = atelierWrapper.querySelector('.editorial-aside p') as HTMLElement | null;
    const tag = atelierWrapper.querySelector('.olive-tag') as HTMLElement | null;
    const cardSection = atelierWrapper.querySelector('#wheel-view-wrapper') as HTMLElement | null;

    // Split text into words and individual character spans for a typing effect without a cursor
    function prepareTyping(container: HTMLElement): HTMLElement[] {
      const existing = container.querySelectorAll('.atelier-type-char');
      if (existing.length > 0) {
        return Array.from(existing) as HTMLElement[];
      }

      const chars: HTMLElement[] = [];

      // Preserve accessibility: store full text in aria-label for screen readers
      if (!container.getAttribute('aria-label')) {
        const fullText = container.textContent?.replace(/\s+/g, ' ').trim() || '';
        if (fullText) {
          container.setAttribute('aria-label', fullText);
        }
      }

      function walk(node: Node) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent || '';
          if (!text) return;

          // Ignore pure whitespace text nodes formatting between elements
          if (/^\s+$/.test(text)) {
            return;
          }

          const tokens = text.split(/(\s+)/);
          const frag = document.createDocumentFragment();

          for (const token of tokens) {
            if (!token) continue;
            if (/^\s+$/.test(token)) {
              frag.appendChild(document.createTextNode(token));
            } else {
              const wordSpan = document.createElement('span');
              wordSpan.className = 'atelier-type-word';
              wordSpan.setAttribute('aria-hidden', 'true');

              for (const c of Array.from(token)) {
                const charSpan = document.createElement('span');
                charSpan.className = 'atelier-type-char';
                charSpan.style.opacity = '0';
                charSpan.textContent = c;
                charSpan.setAttribute('aria-hidden', 'true');
                wordSpan.appendChild(charSpan);
                chars.push(charSpan);
              }
              frag.appendChild(wordSpan);
            }
          }
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const el = node as HTMLElement;
          if (el.classList.contains('atelier-type-word') || el.classList.contains('atelier-type-char')) {
            return;
          }
          Array.from(node.childNodes).forEach(walk);
        }
      }

      walk(container);
      return chars;
    }

    // Prepare typing structures
    const headlineChars = headline ? prepareTyping(headline) : [];
    const subTaglineChars = subTagline ? prepareTyping(subTagline) : [];
    const asideChars = asideP ? prepareTyping(asideP) : [];

    // Make containers visible now that inner character spans are at opacity: 0
    if (headline) headline.style.visibility = 'visible';
    if (subTagline) subTagline.style.visibility = 'visible';
    if (asideP) asideP.style.visibility = 'visible';

    let hasRun = false;
    let currentRunId = 0;
    let activeAnimations: any[] = [];

    function resetAnimations() {
      currentRunId++;
      activeAnimations.forEach((a) => {
        try {
          if (typeof a.cancel === 'function') a.cancel();
          else if (typeof a.stop === 'function') a.stop();
        } catch (_) {}
      });
      activeAnimations = [];

      function clearElementAnim(el: HTMLElement | null) {
        if (el && typeof el.getAnimations === 'function') {
          el.getAnimations().forEach((a) => { try { a.cancel(); } catch (_) {} });
        }
      }

      if (tag) {
        clearElementAnim(tag);
        tag.style.opacity = '0';
        tag.style.transform = 'translateY(8px)';
      }
      if (cardSection) {
        clearElementAnim(cardSection);
        cardSection.style.opacity = '0';
        cardSection.style.transform = 'translateY(24px)';
      }
      headlineChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });
      subTaglineChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });
      asideChars.forEach((c) => {
        clearElementAnim(c);
        c.style.opacity = '0';
      });

      hasRun = false;
    }

    function playAnimations() {
      if (hasRun) return;
      hasRun = true;
      const runId = ++currentRunId;

      const animations: any[] = [];

      // 1. Tag (SECTION 02 // FOUNDRY METRICS)
      if (tag) {
        animations.push(
          animate(
            tag,
            { opacity: [0, 1], y: [8, 0] },
            { duration: 0.4, delay: 0.05, ease: [0.16, 1, 0.3, 1] }
          )
        );
      }

      // 2. Heading: THE TECHNICAL ATELIER (Fluid ink typewriter reveal)
      if (headlineChars.length > 0) {
        animations.push(
          animate(
            headlineChars,
            { opacity: [0, 1] },
            {
              duration: 0.08,
              delay: stagger(0.022, { startDelay: 0.1 }),
              ease: [0.25, 1, 0.5, 1]
            }
          )
        );
      }

      // 3. Section that displays the 3D card cylinder (#wheel-view-wrapper)
      if (cardSection) {
        animations.push(
          animate(
            cardSection,
            { opacity: [0, 1], y: [24, 0] },
            {
              duration: 0.85,
              delay: 0.2,
              ease: [0.16, 1, 0.3, 1]
            }
          )
        );
      }

      // 4. Sub-tagline: ARCHITECTURAL INVENTORY & CORE STACK PROFICIENCY
      if (subTaglineChars.length > 0) {
        animations.push(
          animate(
            subTaglineChars,
            { opacity: [0, 1] },
            {
              duration: 0.04,
              delay: stagger(0.007, { startDelay: 0.28 }),
              ease: 'linear'
            }
          )
        );
      }

      // 5. Aside description text (Typing quote)
      if (asideChars.length > 0) {
        animations.push(
          animate(
            asideChars,
            { opacity: [0, 1] },
            {
              duration: 0.04,
              delay: stagger(0.0035, { startDelay: 0.35 }),
              ease: 'linear'
            }
          )
        );
      }

      activeAnimations = animations;

      const finishAndCleanStyles = () => {
        if (cardSection) {
          cardSection.style.opacity = '1';
          cardSection.style.removeProperty('transform');
        }
        if (tag) {
          tag.style.opacity = '1';
          tag.style.removeProperty('transform');
        }
        headlineChars.forEach((c) => { c.style.opacity = '1'; });
        subTaglineChars.forEach((c) => { c.style.opacity = '1'; });
        asideChars.forEach((c) => { c.style.opacity = '1'; });
      };

      // Ensure full visibility upon animation completion
      Promise.allSettled(animations).then(() => {
        if (runId !== currentRunId) return;
        finishAndCleanStyles();
      });

      // Safety fallback: guarantee full visibility after 1800ms
      setTimeout(() => {
        if (runId !== currentRunId) return;
        finishAndCleanStyles();
      }, 1800);
    }

    function checkAtelierViewport() {
      if (!atelierWrapper) return;
      const rect = atelierWrapper.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const scrollY = window.scrollY || window.pageYOffset;

      // In viewport check: when section top enters bottom 85% of viewport and bottom hasn't scrolled completely away
      const isInView = rect.top < windowHeight * 0.85 && rect.bottom > 80;
      // Section is completely below viewport (user scrolled up above it, e.g. at Hero or scrolling up to top)
      const isBelowViewport = (rect.top >= windowHeight + 40) || (scrollY <= 80);

      if (isInView && !hasRun) {
        playAnimations();
      } else if (isBelowViewport && hasRun) {
        resetAnimations();
      }
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          checkAtelierViewport();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    window.addEventListener('app:reset-scroll-animations', () => {
      resetAnimations();
    });

    if (typeof IntersectionObserver !== 'undefined') {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasRun) {
            checkAtelierViewport();
          }
        });
      }, { threshold: 0.1 });
      observer.observe(atelierWrapper);
    }

    checkAtelierViewport();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAtelierAnimations);
  } else {
    initAtelierAnimations();
  }
  document.addEventListener('astro:page-load', initAtelierAnimations);
</script>

