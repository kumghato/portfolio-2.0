---
interface FoundryPlate {
  shortName: string;
  name: string;
  statusBadge: string;
  assetFile: string;
  accentColor: string;
}

const plates: FoundryPlate[] = [
  {
    shortName: "HTML 5",
    name: "HTML5",
    statusBadge: "WCAG AAA",
    assetFile: "/Assets/HTML.svg",
    accentColor: "#e34f26"
  },
  {
    shortName: "CSS 3",
    name: "CSS3 ",
    statusBadge: "FLUID CORE",
    assetFile: "/Assets/CSS.3.svg",
    accentColor: "#0170ba"
  },
  {
    shortName: "JAVASCRIPT",
    name: "JavaScript",
    statusBadge: "ZERO-LIB",
    assetFile: "/Assets/Javascript.svg",
    accentColor: "#f7df1e"
  },
  {
    shortName: "TAILWIND",
    name: "Tailwind CSS",
    statusBadge: "JIT PURGED",
    assetFile: "/Assets/Tailwind_CSS_Logo.svg",
    accentColor: "#38bdf8"
  },
  {
    shortName: "REACT",
    name: "React",
    statusBadge: "OPTIMAL",
    assetFile: "/Assets/React.svg",
    accentColor: "#61dafb"
  },
  {
    shortName: "NEXT.JS",
    name: "Next.js",
    statusBadge: "STREAMING",
    assetFile: "/Assets/nextjs.svg",
    accentColor: "#1a1a1a"
  },
  {
    shortName: "NODE.JS",
    name: "Node.js",
    statusBadge: "ASYNC I/O",
    assetFile: "/Assets/node-js.svg",
    accentColor: "#8cc84b"
  },
  {
    shortName: "MONGODB",
